---
import {monotonePath} from '../lib/match-activity.mjs';
interface Point {minute:number;activity:number|null;impact?:number|null;actions?:number}
interface Props {timeline:Point[];duration:number;goals?:number[];caption?:string;accent?:string}
const {timeline,duration,goals=[],caption='Évolution de l’activité',accent='#86d9ff'}=Astro.props;
const left=34,right=480,top=23,bottom=143;
const x=(m:number)=>left+(m/duration)*(right-left);
const y=(v:number)=>bottom-Math.max(0,Math.min(100,v))/100*(bottom-top);
const segments:Point[][]=[];
let current:Point[]=[];
for(const point of timeline){
 if(point.activity===null){if(current.length)segments.push(current);current=[];}
 else current.push(point);
}
if(current.length)segments.push(current);
const paths=segments.map(segment=>{
 const first=segment[0],last=segment.at(-1)!;
 const path=monotonePath(segment.map(p=>({x:x(p.minute),y:y(p.activity??0)})));
 return {line:path,area:path+' L '+x(last.minute)+' '+bottom+' L '+x(first.minute)+' '+bottom+' Z'};
});
const actionMinutes=timeline.filter(p=>(p.actions??0)>0);
const ticks=[...new Set([0,45,90,duration].filter(n=>n<=duration))];
---
<svg class="ax-mini-chart" viewBox="0 0 500 207" role="img" aria-label={caption}>
 <rect x="0" y="0" width="500" height="207" rx="12" fill="#061b30"/>
 {[0,25,50,75,100].map(t=><g><line class="ax-mini-grid" x1={left} x2={right} y1={y(t)} y2={y(t)}/>{(t===0||t===50||t===100)&&<text class="ax-mini-tick" x="27" y={y(t)+4} text-anchor="end">{t}</text>}</g>)}
 {ticks.map(t=><g><line class="ax-mini-grid vertical" x1={x(t)} x2={x(t)} y1={top} y2={bottom}/><text class="ax-mini-tick" x={x(t)} y="167" text-anchor="middle">{t}′</text></g>)}
 {duration>90&&<line x1={x(90)} x2={x(90)} y1={top} y2={bottom} stroke="#82bbdb" stroke-dasharray="3 4" stroke-opacity=".7"/>}
 {paths.map(p=><g><path d={p.area} fill={accent} fill-opacity=".105"/><path d={p.line} fill="none" stroke={accent} stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" class="ax-mini-line"/></g>)}
 {goals.map(m=>timeline[m]?.activity!=null?<circle cx={x(m)} cy={y(timeline[m].activity!)} r="4.5" fill="#ff6996" stroke="#fff2f7" stroke-width="1.7"><title>But · {m}′</title></circle>:null)}
 <text class="ax-mini-rail-title" x={left} y="183">ACTIONS</text>
 <line class="ax-mini-rail-base" x1={left} x2={right} y1="194" y2="194"/>
 {actionMinutes.map(p=><circle class:list={['ax-mini-event-dot',goals.includes(p.minute)?'goal':'']} cx={x(p.minute)} cy="194" r={goals.includes(p.minute)?3.6:2.45}><title>{p.minute}′ · {p.actions} action{p.actions===1?'':'s'}</title></circle>)}
</svg>