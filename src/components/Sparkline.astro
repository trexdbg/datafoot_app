---
interface Props {
  values: number[];
  width?: number;
  height?: number;
}
const { values = [], width = 160, height = 42 } = Astro.props;
const clean = values.filter((value) => Number.isFinite(value));
const min = clean.length ? Math.min(...clean) : 0;
const max = clean.length ? Math.max(...clean) : 100;
const range = Math.max(max - min, 1);
const pad = 3;
const points = clean.map((value, index) => {
  const x = clean.length <= 1 ? width / 2 : pad + (index / (clean.length - 1)) * (width - pad * 2);
  const y = height - pad - ((value - min) / range) * (height - pad * 2);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
---
<svg class="sparkline" viewBox={`0 0 ${width} ${height}`} aria-hidden="true" preserveAspectRatio="none">
  <line x1="0" y1={height * .5} x2={width} y2={height * .5} class="spark-mid" />
  {clean.length > 1 && <polyline points={points} fill="none" class="spark-path" />}
</svg>
