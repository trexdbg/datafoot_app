---
import {monotonePath,actionLabel,pulsePenalty,PULSE_BANDS} from '../lib/match-activity.mjs';
interface Point {minute:number;activity:number|null;impact?:number|null;actions?:number;penaltyGain?:number;events?:Array<{kind:string;outcome:string;playerName?:string}>}
interface Props {timeline:Point[];duration:number;goals?:number[];assists?:number[];title?:string;accent?:string;metric?:'activity'|'impact';compact?:boolean}
const {timeline,duration,goals=[],assists=[],title='Activité sur le match',accent='#66d8ff',metric='activity',compact=false}=Astro.props;
const left=33,right=548,top=19,bottom=156;
const X=(minute:number)=>left+(minute/duration)*(right-left);
const Y=(score:number)=>bottom-Math.min(100,Math.max(0,score))/100*(bottom-top);
const segments:Point[][]=[];let segment:Point[]=[];
for(const p of timeline) {
 if(p[metric]==null){if(segment.length)segments.push(segment);segment=[];}
 else segment.push(p);
}
if(segment.length)segments.push(segment);
const paths=segments.map(points=>{
 const line=monotonePath(points.map(p=>({x:X(p.minute),y:Y(p[metric]??0)})));
 return {line,area:line+' L '+X(points.at(-1)!.minute)+' '+bottom+' L '+X(points[0].minute)+' '+bottom+' Z'};
});
const max=[...timeline].filter(p=>p[metric]!=null).sort((a,b)=>(b[metric]??0)-(a[metric]??0))[0];
const markers=timeline.filter(p=>(p.actions??0)>0);
const xTicks=[0,45,90,duration].filter((v,i,a)=>v<=duration&&a.indexOf(v)===i);
const encoded=JSON.stringify(timeline.map(p=>[p.activity,p.impact??null,p.actions??0,(p.events??[]).slice(0,5).map(e=>(e.playerName?e.playerName+' · ':'')+actionLabel(e)+(pulsePenalty(e)>0?' · malus −'+pulsePenalty(e).toFixed(2):'')),p.penaltyGain??0]));
const clipPrefix='wc-bands-'+Math.random().toString(36).slice(2,11);
---
<div class:list={['wc-wave-shell',compact&&'small']} data-pulse-wave data-duration={duration} data-values={encoded} data-metric={metric} data-name={title}>
 <svg class="wc-wave" viewBox="0 0 580 198" role="img" aria-label={title+'. Graphique interactif : déplacer la souris, toucher le graphique ou utiliser les flèches pour lire chaque minute.'} tabindex="0">
  <rect width="580" height="198" rx="13" fill="#071a2d"/>
  <defs>
   <clipPath id={clipPrefix+'-low'}><rect x={left} y={Y(25)} width={right-left} height={Y(0)-Y(25)}/></clipPath>
   <clipPath id={clipPrefix+'-steady'}><rect x={left} y={Y(75)} width={right-left} height={Y(25)-Y(75)}/></clipPath>
   <clipPath id={clipPrefix+'-high'}><rect x={left} y={top} width={right-left} height={Y(75)-top}/></clipPath>
  </defs>
  <rect x={left} y={top} width={right-left} height={Y(75)-top} fill={PULSE_BANDS.high.color} opacity=".045"/>
  <rect x={left} y={Y(25)} width={right-left} height={Y(0)-Y(25)} fill={PULSE_BANDS.low.color} opacity=".045"/>
  {[0,25,50,75,100].map(value=><g><line x1={left} x2={right} y1={Y(value)} y2={Y(value)} class="wc-wave-grid"/>{value%50===0&&<text x="27" y={Y(value)+4} class="wc-wave-tick" text-anchor="end">{value}</text>}</g>)}
  {xTicks.map(minute=><g><line x1={X(minute)} x2={X(minute)} y1={top} y2={bottom} class="wc-wave-grid vertical"/><text x={X(minute)} y="175" text-anchor="middle" class="wc-wave-tick">{minute}′</text></g>)}
  {duration>90&&<line x1={X(90)} x2={X(90)} y1={top} y2={bottom} stroke="#abd2e8" stroke-dasharray="4 5" opacity=".55"/>}
  {paths.map(path=><g><path d={path.area} fill={accent} opacity=".08"/>{(['low','steady','high'] as const).map(band=><path d={path.line} fill="none" stroke={PULSE_BANDS[band].color} stroke-width="3.7" stroke-linecap="round" stroke-linejoin="round" clip-path={'url(#'+clipPrefix+'-'+band+')'} class="wc-wave-line"/>)}</g>)}
  {goals.map(minute=>timeline[minute]?.[metric]!=null?<circle cx={X(minute)} cy={Y(timeline[minute][metric]??0)} r="5.3" fill="#ff789e" stroke="#fff1f5" stroke-width="1.7"><title>But à la {minute}′</title></circle>:null)}
  {assists.map(minute=>timeline[minute]?.[metric]!=null?<g><rect x={X(minute)-4} y={Y(timeline[minute][metric]??0)-4} width="8" height="8" transform={'rotate(45 '+X(minute)+' '+Y(timeline[minute][metric]??0)+')'} fill="#FFE7A7" stroke="#fff" stroke-width="1"><title>Passe décisive à la {minute}′</title></rect></g>:null)}
  <text x={left} y="188" class="wc-wave-caption">ÉVÉNEMENTS</text>
  {markers.map(p=><circle cx={X(p.minute)} cy="190" r="2.5" fill="#88acc3" opacity=".88"><title>{p.minute}′ · {p.actions} actions</title></circle>)}
  <line data-wave-cursor x1="33" x2="33" y1={top} y2={bottom} stroke="#d9f5ff" stroke-dasharray="4 4" stroke-width="1.6" visibility="hidden" pointer-events="none"/>
  <circle data-wave-point cx="33" cy={bottom} r="6" fill="#f7ffff" stroke={accent} stroke-width="2.5" visibility="hidden" pointer-events="none"/>
 </svg>
 <div class="wc-wave-tooltip" data-wave-tooltip hidden aria-hidden="true"><strong data-tip-minute>—</strong><span data-tip-values>—</span><span data-tip-actions>—</span></div>
 <div class="wc-wave-readout" aria-live="off">
   <span data-wave-minute>Survole ou touche la courbe</span>
   <span data-wave-activity>Activité <strong>—</strong></span>
   <span data-wave-impact>Impact <strong>—</strong></span>
   <span data-wave-events>Actions <strong>—</strong></span>
 </div>
 <p class="wc-wave-action-summary" data-wave-event-list>Choisis une minute sur la courbe pour découvrir les actions.</p>
</div>
<script>
(() => {
 const apply = () => document.querySelectorAll<HTMLElement>('[data-pulse-wave]').forEach(shell => {
  if(shell.dataset.ready==='true')return;
  shell.dataset.ready='true';
  const svg=shell.querySelector<SVGSVGElement>('svg.wc-wave');
  const cursor=shell.querySelector<SVGLineElement>('[data-wave-cursor]');
  const point=shell.querySelector<SVGCircleElement>('[data-wave-point]');
  const minuteLabel=shell.querySelector<HTMLElement>('[data-wave-minute]');
  const activity=shell.querySelector<HTMLElement>('[data-wave-activity] strong');
  const impact=shell.querySelector<HTMLElement>('[data-wave-impact] strong');
  const events=shell.querySelector<HTMLElement>('[data-wave-events] strong');
  const eventList=shell.querySelector<HTMLElement>('[data-wave-event-list]');
  const tooltip=shell.querySelector<HTMLElement>('[data-wave-tooltip]');
  const tipMinute=shell.querySelector<HTMLElement>('[data-tip-minute]');
  const tipValues=shell.querySelector<HTMLElement>('[data-tip-values]');
  const tipActions=shell.querySelector<HTMLElement>('[data-tip-actions]');
  if(!svg||!cursor||!point||!minuteLabel||!activity||!impact||!events||!eventList||!tooltip||!tipMinute||!tipValues||!tipActions)return;
  const timeline=JSON.parse(shell.dataset.values||'[]') as Array<[number|null,number|null,number,string[],number]>;
  const duration=Number(shell.dataset.duration||'90');
  const metric=shell.dataset.metric==='impact'?1:0;
  let activeMinute=-1;
  const select=(value:number) => {
   const minute=Math.max(0,Math.min(duration,Math.round(value)));
   activeMinute=minute;
   const current=timeline[minute]||[null,null,0,[],0];
   const x=33+minute/duration*515;
   cursor.setAttribute('x1',String(x));
   cursor.setAttribute('x2',String(x));
   cursor.setAttribute('visibility','visible');
   if(current[metric]==null)point.setAttribute('visibility','hidden');
   else {
    point.setAttribute('visibility','visible');
    point.setAttribute('cx',String(x));
    point.setAttribute('cy',String(156-(current[metric]??0)/100*137));
   }
   minuteLabel.textContent=minute+'′';
   activity.textContent=current[0]==null?'Hors terrain':Math.round(current[0])+'/100';
   impact.textContent=current[1]==null?'—':Math.round(current[1])+'/100';
   events.textContent=String(current[2]||0);
   const names=current[3]||[];
   eventList.textContent=names.length?names.join(' · ')+(current[2]>names.length?' · +'+(current[2]-names.length)+' autres':''):current[2]?'Événements collectifs : ouvre le match pour les actions individuelles.':current[0]==null?'Joueur hors du terrain.':'Aucune action enregistrée : les impulsions décroissent.';
   const v=current[metric];
   const color=v==null?'#52D3EF':v<25?'#8A9DB8':v>75?'#B8F27C':'#52D3EF';
   point.setAttribute('stroke',color);
   tooltip.hidden=false;
   tooltip.style.left=Math.max(20,Math.min(80,x/580*100))+'%';
   tooltip.style.top=Math.max(5,Math.min(svg.clientHeight-78,(v==null?70:156-v/100*137)/198*svg.clientHeight-81))+'px';
   tooltip.style.borderColor=color;
   tipMinute.textContent=minute+'′ · '+(v==null?'Hors terrain':v<25?'Rythme discret':v>75?'Temps fort':'Dans le jeu');
   tipValues.textContent='Activité '+(current[0]==null?'—':Math.round(current[0])+'/100')+' · Impact '+(current[1]==null?'—':Math.round(current[1])+'/100');
   tipActions.textContent=names.length?names.slice(0,3).join(' · ')+(current[2]>3?' · +'+(current[2]-3)+' autres':''):(current[0]==null?'Hors terrain':current[2]+' action'+(current[2]===1?'':'s')+' à cette minute');
   shell.classList.add('is-inspecting');
  };
  const fromPointer=(event:PointerEvent)=>{
   const rect=svg.getBoundingClientRect();
   select(((event.clientX-rect.left)/rect.width*580-33)/515*duration);
  };
  svg.addEventListener('pointermove',fromPointer);
  svg.addEventListener('pointerdown',event=>{fromPointer(event);});
  svg.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();});
  svg.addEventListener('keydown',event=>{
   if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){
    event.preventDefault();event.stopPropagation();
    const next=event.key==='Home'?0:event.key==='End'?duration:Math.max(0,activeMinute)+(event.key==='ArrowRight'?1:-1);
    select(next);
   }
  });
 });
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',apply,{once:true});
 else apply();
})();
</script>