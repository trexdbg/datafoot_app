---
import {monotonePath} from '../lib/match-activity.mjs';
interface Point {minute:number;activity:number|null;impact?:number|null;actions?:number}
interface Props {timeline:Point[];duration:number;goals?:number[];title?:string;accent?:string;metric?:'activity'|'impact';compact?:boolean}
const {timeline,duration,goals=[],title='Activité sur le match',accent='#66d8ff',metric='activity',compact=false}=Astro.props;
const left=33,right=548,top=19,bottom=156;
const X=(minute:number)=>left+(minute/duration)*(right-left);
const Y=(score:number)=>bottom-Math.min(100,Math.max(0,score))/100*(bottom-top);
const points:Point[][]=[];let current:Point[]=[];
for(const p of timeline){if(p[metric]==null){if(current.length)points.push(current);current=[];}else current.push(p);}
if(current.length)points.push(current);
const segments=points.map(list=>{
 const d=monotonePath(list.map(p=>({x:X(p.minute),y:Y(p[metric]??0)})));
 return {line:d,area:d+' L '+X(list.at(-1)!.minute)+' '+bottom+' L '+X(list[0].minute)+' '+bottom+' Z'};
});
const peaks=[...timeline].filter(p=>p[metric]!=null).sort((a,b)=>(b[metric]??0)-(a[metric]??0));
const major=peaks[0];
const marks=timeline.filter(p=>(p.actions??0)>0);
const xticks=[0,45,90,duration].filter((x,i,a)=>x<=duration&&a.indexOf(x)===i);
---
<svg class:list={['wc-wave',compact&&'small']} viewBox="0 0 580 198" role="img" aria-label={title}>
 <rect width="580" height="198" rx="13" fill="#071a2d"/>
 {[0,25,50,75,100].map(score=><g><line x1={left} x2={right} y1={Y(score)} y2={Y(score)} class="wc-wave-grid"/>{score%50===0&&<text x="27" y={Y(score)+4} class="wc-wave-tick" text-anchor="end">{score}</text>}</g>)}
 {xticks.map(minute=><g><line x1={X(minute)} x2={X(minute)} y1={top} y2={bottom} class="wc-wave-grid vertical"/><text x={X(minute)} y="175" text-anchor="middle" class="wc-wave-tick">{minute}′</text></g>)}
 {segments.map(segment=><g><path d={segment.area} fill={accent} opacity=".1"/><path d={segment.line} fill="none" stroke={accent} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="wc-wave-line"/></g>)}
 {major&&<circle cx={X(major.minute)} cy={Y(major[metric]??0)} r="4" fill="#b6f4ff" stroke={accent} stroke-width="2"><title>Point culminant : {Math.round(major[metric]??0)}/100 · {major.minute}′</title></circle>}
 {goals.map(minute=>timeline[minute]?.[metric]!=null?<circle cx={X(minute)} cy={Y(timeline[minute][metric]??0)} r="5" fill="#ff789e" stroke="#fff1f5" stroke-width="1.7"><title>But · {minute}′</title></circle>:null)}
 <text x={left} y="188" class="wc-wave-caption">ÉVÉNEMENTS</text>
 {marks.map(p=><circle cx={X(p.minute)} cy="190" r="2" fill="#759eb8" opacity=".87"><title>{p.minute}′ · {p.actions} actions</title></circle>)}
</svg>