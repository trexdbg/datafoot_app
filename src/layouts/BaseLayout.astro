---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  publishedAt?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = 'DataFoot — analyses football, xG et statistiques',
  description = 'DataFoot analyse le football à partir de données sourcées : xG, xA, tirs, performances joueurs et signaux statistiques.',
  canonicalPath,
  ogType = 'website',
  publishedAt,
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;
const siteOrigin = Astro.site ?? new URL('https://trexdbg.github.io');
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin).toString();
const methodologyUrl = new URL(`${base}/methodologie/`, siteOrigin).toString();
const homeUrl = new URL(`${base}/`, siteOrigin).toString();

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${homeUrl}#organization`,
      name: 'DataFoot',
      url: homeUrl,
      description: 'Média data football automatisé, fondé sur des statistiques traçables et des sources explicites.',
      publishingPrinciples: methodologyUrl,
    },
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      name: 'DataFoot',
      url: homeUrl,
      inLanguage: 'fr-FR',
      publisher: { '@id': `${homeUrl}#organization` },
    },
  ],
};

const schemaBlocks = [baseSchema, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#0a0d0b" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap.xml')} />

    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DataFoot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    {schemaBlocks.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href={url('/')} aria-label="DataFoot — accueil">
          <span class="brand-mark">DF</span>
          <span class="brand-copy"><strong>DataFoot</strong><small>football intelligence</small></span>
        </a>
        <nav aria-label="Navigation principale">
          <a href={url('/articles/')}>Analyses</a>
          <a href={url('/stats/')}>Data</a>
          <a href={url('/methodologie/')}>Méthode</a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer>
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href={url('/')}><span class="brand-mark">DF</span><span>DataFoot</span></a>
          <p>Des analyses football construites à partir de données traçables, avec sources et méthodologie visibles.</p>
        </div>
        <div>
          <strong>Explorer</strong>
          <a href={url('/articles/')}>Analyses</a>
          <a href={url('/stats/')}>Dataset</a>
          <a href={url('/methodologie/')}>Méthodologie</a>
        </div>
        <div>
          <strong>Accès machines</strong>
          <a href={url('/data/stats.json')}>JSON public</a>
          <a href={url('/sitemap.xml')}>Sitemap XML</a>
          <a href={url('/llms.txt')}>llms.txt</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} DataFoot</span>
        <span>Les xG et xA sont des indicateurs probabilistes, pas des certitudes.</span>
      </div>
    </footer>
  </body>
</html>
