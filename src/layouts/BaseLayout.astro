---
import '../styles/global.css';
import { SORARE_REFERRAL_URL } from '../lib/referrals';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  publishedAt?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = 'DataFoot — analyses football, xG et statistiques',
  description = 'DataFoot analyse le football à partir de données sourcées : xG, xA, tirs, performances joueurs et signaux statistiques.',
  canonicalPath,
  ogType = 'website',
  publishedAt,
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;
const siteOrigin = Astro.site ?? new URL('https://trexdbg.github.io');
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin).toString();
const methodologyUrl = new URL(`${base}/methodologie/`, siteOrigin).toString();
const homeUrl = new URL(`${base}/`, siteOrigin).toString();

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${homeUrl}#organization`,
      name: 'DataFoot',
      url: homeUrl,
      description: 'Média data football fondé sur des statistiques traçables et des sources explicites.',
      publishingPrinciples: methodologyUrl,
    },
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      name: 'DataFoot',
      url: homeUrl,
      inLanguage: 'fr-FR',
      publisher: { '@id': `${homeUrl}#organization` },
    },
  ],
};

const schemaBlocks = [baseSchema, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#0a0d0b" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap.xml')} />

    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DataFoot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <script is:inline>
      (() => {
        const measurementId = 'G-G2M1RYC5K1';
        const consentKey = 'datafoot_analytics_consent';

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };

        function loadAnalytics() {
          if (window.__datafootAnalyticsLoaded) return;
          window.__datafootAnalyticsLoaded = true;

          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
          document.head.appendChild(script);

          window.gtag('js', new Date());
          window.gtag('config', measurementId, {
            send_page_view: true
          });
        }

        window.__datafootSetAnalyticsConsent = function(value) {
          localStorage.setItem(consentKey, value);
          if (value === 'granted') loadAnalytics();
        };

        if (localStorage.getItem(consentKey) === 'granted') {
          loadAnalytics();
        }
      })();
    </script>
    {schemaBlocks.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href={url('/')} aria-label="DataFoot — accueil">
          <span class="brand-mark">DF</span>
          <span class="brand-copy"><strong>DataFoot</strong><small>football intelligence</small></span>
        </a>
        <nav aria-label="Navigation principale">
          <a href={url('/articles/')}>Analyses</a>
          <a href={url('/stats/')}>Data</a>
          <a href={url('/methodologie/')}>Méthode</a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>

    <aside class="analytics-consent" data-analytics-consent hidden aria-label="Mesure d’audience">
      <p><strong>Mesure d’audience</strong><span>DataFoot utilise Google Analytics pour comprendre quelles pages sont consultées et améliorer le site.</span></p>
      <div>
        <button type="button" data-analytics-deny>Refuser</button>
        <button type="button" class="accept" data-analytics-accept>Accepter</button>
      </div>
    </aside>
    <script is:inline>
      (() => {
        const consentKey = 'datafoot_analytics_consent';
        const panel = document.querySelector('[data-analytics-consent]');
        const choice = localStorage.getItem(consentKey);

        if (panel && !choice) panel.hidden = false;

        document.querySelector('[data-analytics-accept]')?.addEventListener('click', () => {
          window.__datafootSetAnalyticsConsent?.('granted');
          if (panel) panel.hidden = true;
        });

        document.querySelector('[data-analytics-deny]')?.addEventListener('click', () => {
          window.__datafootSetAnalyticsConsent?.('denied');
          if (panel) panel.hidden = true;
        });

        document.addEventListener('click', (event) => {
          if (localStorage.getItem(consentKey) !== 'granted' || !window.gtag) return;
          const link = event.target instanceof Element ? event.target.closest('a[href*="sorare.com/"]') : null;
          if (!link) return;
          window.gtag('event', 'sorare_click', {
            link_url: link.href,
            page_path: location.pathname
          });
        });

        const profile = document.querySelector('.visual-analysis');
        if (profile && 'IntersectionObserver' in window) {
          let sent = false;
          const observer = new IntersectionObserver((entries) => {
            if (sent || localStorage.getItem(consentKey) !== 'granted' || !window.gtag) return;
            if (entries.some((entry) => entry.isIntersecting)) {
              sent = true;
              window.gtag('event', 'player_profile_view', {
                page_path: location.pathname
              });
              observer.disconnect();
            }
          }, { threshold: 0.45 });
          observer.observe(profile);
        }
      })();
    </script>

    <footer>
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href={url('/')}><span class="brand-mark">DF</span><span>DataFoot</span></a>
          <p>Des analyses football construites à partir de données traçables, avec sources et méthodologie visibles.</p>
        </div>
        <div>
          <strong>Explorer</strong>
          <a href={url('/articles/')}>Analyses</a>
          <a href={url('/stats/')}>Dataset</a>
          <a href={url('/methodologie/')}>Méthodologie</a>
          <a href={SORARE_REFERRAL_URL} rel="sponsored nofollow noreferrer">Sorare · parrainage ↗</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} DataFoot</span>
        <span>Les xG et xA sont des indicateurs probabilistes, pas des certitudes.</span>
      </div>
    </footer>
  </body>
</html>
