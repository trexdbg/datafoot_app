---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import profile from '../../../data/matches/2022-final-mbappe.json';
import actionsData from '../../../data/matches/2022-final-mbappe-actions.json';
import {actionImpact, actionLabel, computeActivity, monotonePath} from '../../../lib/match-activity.mjs';
import '../../../styles/match-weather.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {timeline} = computeActivity(actionsData.events, profile.match.duration_minutes);
const rawEvents = actionsData.events;
const maxActivity = Math.max(...timeline.map(point => point.activity));
const axisMax = Math.max(100, Math.ceil(maxActivity / 25) * 25);
const left = 66, right = 1170, top = 218, bottom = 530;
const x = (minute: number) => left + minute / profile.match.duration_minutes * (right - left);
const y = (activity: number) => bottom - activity / axisMax * (bottom - top);
const smooth = monotonePath(timeline.map(p => ({x:x(p.minute),y:y(p.activity)})));
const area = smooth + ' L ' + right + ' ' + bottom + ' L ' + left + ' ' + bottom + ' Z';
const xTicks = [0,15,30,45,60,75,90,105,120];
const yTicks = Array.from({length: axisMax / 25 + 1}, (_, i) => i * 25).filter(v=> v%50===0 || v===axisMax);
const goalScores = new Map(profile.goals.filter(goal => goal.for_player).map(goal => [goal.minute,goal.score]));
const firstTwo = profile.goals.filter(goal=>goal.for_player).slice(0,2);
const doubleSeconds = firstTwo.length===2 ? (firstTwo[1].minute-firstTwo[0].minute)*60+firstTwo[1].second-firstTwo[0].second : 95;
const annotations = [
 {minute:14, label:'Passe', value:'+5', labelX:x(14), labelY:128,kind:'pass'},
 {minute:38, label:'Passe', value:'+5', labelX:x(38), labelY:139,kind:'pass'},
 {minute:50, label:'2 dribbles', value:'+10', labelX:x(50), labelY:98,kind:'dribble'},
 {minute:69, label:'2 passes', value:'+10', labelX:x(69), labelY:132,kind:'pass'},
 {minute:80, label:'But · 2–1', value:'+45', labelX:x(80)-55, labelY:83,kind:'goal'},
 {minute:81, label:'But · 2–2', value:'+45', labelX:x(81)+55, labelY:136,kind:'goal'},
 {minute:96, label:'Passe + dribble', value:'+10', labelX:x(96)-36, labelY:103,kind:'dribble'},
 {minute:99, label:'Dribble', value:'+5', labelX:x(99)+42, labelY:154,kind:'dribble'},
 {minute:118, label:'But · 3–3', value:'+45', labelX:x(118)-38, labelY:87,kind:'goal'},
 {minute:124, label:'2 dribbles', value:'+10', labelX:x(124)+12, labelY:146,kind:'dribble'}
];
const markerStack = new Map();
const markers = rawEvents.map(action => {
 const index = markerStack.get(action.minute) || 0;
 markerStack.set(action.minute, index + 1);
 const impact = actionImpact(action);
 return { ...action, markerY: 600 - index*5, impact, label:actionLabel(action), color:action.kind==='Shot'&&action.outcome==='Goal'?'goal':impact?'positive':'neutral' };
});
const readoutAt80 = timeline[80].activity;
const sourcePath = base+'/data/matches/2022-final-mbappe.json';
---
<BaseLayout
 title="Profil de match Mbappé · Finale 2022 | DataFoot"
 description="Les 148 événements StatsBomb de Kylian Mbappé en finale de la Coupe du monde 2022, représentés par une courbe d'activité à règles transparentes."
 canonicalPath={base+'/matchs/finale-2022/mbappe/'}
>
 <div class="mw-root">
  <div class="shell mw-heading">
   <a class="mw-back" href={base+'/'}>← RETOUR AUX ANALYSES</a>
   <p class="mw-kicker">DATAFOOT / PROFILS DE MATCH / N° 001</p>
  </div>
  <section class="shell mw-report" aria-labelledby="mw-main-title">
   <div class="mw-report-top">
    <div class="mw-title-group">
     <span class="mw-overline">FINALE COUPE DU MONDE 2022</span>
     <h1 id="mw-main-title">Profil de match</h1>
     <p>Courbe d’activité de <strong>Kylian Mbappé</strong> minute par minute</p>
    </div>
    <div class="mw-scoreboard" aria-label="Argentine 3, France 3. Argentine vainqueur aux tirs au but 4 à 2">
     <small>FINALE · 18 DÉC. 2022</small>
     <strong>ARG <span>3–3</span> FRA</strong>
     <small>Argentine : 4–2 aux tirs au but</small>
    </div>
   </div>

   <div class="mw-rules" aria-label="Règles du score d'activité">
    <div><b class="mw-rule-symbol start">◯</b><span><strong>Départ 50</strong><small>Score initial</small></span></div>
    <div><b class="mw-rule-symbol positive">↗</b><span><strong>Passe +5</strong><small>Réussie uniquement</small></span></div>
    <div><b class="mw-rule-symbol positive">⌁</b><span><strong>Dribble +5</strong><small>Réussi uniquement</small></span></div>
    <div><b class="mw-rule-symbol goal">⚽</b><span><strong>But +45</strong><small>Action décisive</small></span></div>
    <div><b class="mw-rule-symbol decay">↘</b><span><strong>−1 / min</strong><small>Baisse naturelle</small></span></div>
    <div><b class="mw-rule-symbol start">◇</b><span><strong>Minimum 0</strong><small>Jamais négatif</small></span></div>
   </div>

   <div class="mw-chart-scroll">
    <svg id="mw-chart" viewBox="0 0 1240 640" role="img" aria-labelledby="mw-svg-title mw-svg-desc">
     <title id="mw-svg-title">Profil d’activité calculé de Kylian Mbappé, Argentine–France, 18 décembre 2022</title>
     <desc id="mw-svg-desc">Score initial 50, perte de 1 chaque minute, gain de 5 pour les passes et dribbles réussis, 45 pour chaque but, minimum zéro. Les 148 événements du joueur sont représentés sous le graphique ; les buts ont un dégradé rose.</desc>
     <defs>
      <linearGradient id="mw-fill" x1="0" x2="0" y1="0" y2="1">
       <stop offset="0" stop-color="#169ef4" stop-opacity=".34"/>
       <stop offset=".9" stop-color="#169ef4" stop-opacity=".025"/>
      </linearGradient>
      <linearGradient id="mw-activity-stroke" x1="0" y1="0" x2="1" y2="0">
       <stop offset="0" stop-color="#5bc8ff"/>
       <stop offset=".600" stop-color="#59c7ff"/>
       <stop offset=".628" stop-color="#a8a3ee"/>
       <stop offset=".645" stop-color="#ff6394"/>
       <stop offset=".660" stop-color="#ff6394"/>
       <stop offset=".695" stop-color="#5bc8ff"/>
       <stop offset=".911" stop-color="#5bc8ff"/>
       <stop offset=".935" stop-color="#f279b0"/>
       <stop offset=".950" stop-color="#ff638e"/>
       <stop offset=".968" stop-color="#77c8ff"/>
       <stop offset="1" stop-color="#5bc8ff"/>
      </linearGradient>
      <filter id="mw-neon" x="-15%" y="-40%" width="130%" height="180%"><feGaussianBlur stdDeviation="5"/></filter>
     </defs>
     <rect width="1240" height="640" fill="#081a30"/>
     <ellipse cx="620" cy="260" rx="610" ry="360" fill="#123f69" opacity=".22"/>
     <g class="mw-grid">
      {yTicks.map(tick=><g><line x1={left} x2={right} y1={y(tick)} y2={y(tick)}/><text x="51" y={y(tick)+5} text-anchor="end" class="mw-tick">{tick}</text></g>)}
      {xTicks.map(tick=><line class="mw-grid-vertical" x1={x(tick)} x2={x(tick)} y1={top} y2={bottom}/>)}
      <line class="mw-extra-line" x1={x(90)} x2={x(90)} y1="191" y2="608"/>
      <text class="mw-period-label" x={x(90)+12} y="213">PROLONGATION</text>
     </g>
     <text class="mw-axis-title" x={left} y="196">SCORE D’ACTIVITÉ</text>
     <path d={area} fill="url(#mw-fill)"/>
     <path d={smooth} fill="none" stroke="url(#mw-activity-stroke)" stroke-width="16" stroke-opacity=".48" filter="url(#mw-neon)"/>
     <path d={smooth} fill="none" stroke="url(#mw-activity-stroke)" stroke-width="4.25" stroke-linejoin="round" stroke-linecap="round"/>
     {annotations.map(a=><g class:list={['mw-annotation',a.kind]}>
      <path d={'M '+a.labelX+' '+(a.labelY+43)+' L '+x(a.minute)+' '+(y(timeline[a.minute].activity)-10)} class="mw-annotation-guide"/>
      <circle cx={x(a.minute)} cy={y(timeline[a.minute].activity)} r={a.kind==='goal'?7:5} class="mw-annotation-dot"/>
      <text x={a.labelX} y={a.labelY} text-anchor="middle" class="mw-annotation-minute">{a.minute}′</text>
      <text x={a.labelX} y={a.labelY+17} text-anchor="middle" class="mw-annotation-name">{a.label}</text>
      <text x={a.labelX} y={a.labelY+34} text-anchor="middle" class="mw-annotation-value">{a.value}</text>
     </g>)}
     <g class="mw-axis">
      <line x1={left} y1={bottom} x2={right} y2={bottom}/>
      {xTicks.map(t=><g><line x1={x(t)} x2={x(t)} y1={bottom} y2={bottom+8}/><text x={x(t)} y="553" text-anchor="middle">{t}′</text></g>)}
     </g>
     <text class="mw-event-rail-label" x={left} y="578">ÉVÉNEMENTS STATS BOMB · {rawEvents.length} ACTIONS</text>
     <line x1={left} x2={right} y1="604" y2="604" stroke="#87b1d0" stroke-opacity=".27"/>
     {markers.map(m=><g class:list={['mw-rail-marker',m.color]}>
      <circle cx={x(m.minute)} cy={m.markerY} r={m.color==='goal'?4:2.65}/>
      <title>{m.minute}′{String(m.second).padStart(2,'0')}″ — {m.label}{m.impact?' +'+m.impact:''}</title>
     </g>)}
     <line id="mw-cursor" x1={x(80)} y1={top} x2={x(80)} y2={bottom} stroke="#d9f1ff" stroke-width="1.4" stroke-dasharray="5 5" opacity=".7" pointer-events="none"/>
     <circle id="mw-dot" cx={x(80)} cy={y(readoutAt80)} r="7" fill="#ff759d" stroke="#fff" stroke-width="2" pointer-events="none"/>
     <rect id="mw-hit" x={left} y={top} width={right-left} height={bottom-top} fill="transparent" tabindex="0" aria-label="Examiner le score de chaque minute avec les flèches ou la souris"/>
    </svg>
   </div>
   <div class="mw-explorer">
    <div class="mw-explorer-head">
     <div><span class="mw-eyebrow">EXPLORER LA COURBE</span><strong><output id="mw-readout" for="mw-minute">80′ · Score {readoutAt80}</output></strong></div>
     <span id="mw-count">{timeline[80].actions} action(s) à cette minute</span>
    </div>
    <input id="mw-minute" type="range" min="0" max={profile.match.duration_minutes} step="1" value="80" aria-label="Minute à examiner" />
    <div class="mw-active-events" id="mw-active-events" aria-live="polite">Sélectionner une minute pour voir les actions correspondantes.</div>
   </div>
   <div class="mw-legend">
    <span><i class="mw-swatch blue"></i> Évolution du score</span>
    <span><i class="mw-swatch pink"></i> Buts de Mbappé</span>
    <span><i class="mw-swatch green"></i> Actions réussies (+5)</span>
    <span><i class="mw-swatch muted"></i> Autres événements recensés</span>
   </div>
  </section>

  <section class="shell mw-insights">
   <div class="mw-lead-insight"><p class="mw-kicker">LE POINT DE BASCULE</p>
    <h2>Deux buts.<br/><em>{doubleSeconds} secondes.</em></h2>
    <p>Un penalty à la 80′ et une reprise dans le jeu à la 81′. Les deux buts sont visibles individuellement dans le profil.</p>
   </div>
   <div class="mw-numbers">
    <div><span>BUTS</span><strong>{profile.summary.goals}</strong></div>
    <div><span>PASSES RÉUSSIES</span><strong>{rawEvents.filter(a=>a.kind==='Pass' && a.outcome==='Complete').length}</strong></div>
    <div><span>DRIBBLES RÉUSSIS</span><strong>{profile.summary.successful_dribbles}<small> / {profile.summary.dribbles}</small></strong></div>
    <div><span>ACTIONS TRACÉES</span><strong>{rawEvents.length}</strong></div>
   </div>
  </section>

  <section class="shell mw-explain">
   <div><p class="mw-kicker">LECTURE DU GRAPHIQUE</p><h2>Chaque action compte.<br/>Pas de météo.</h2></div>
   <div>
    <p>Le score commence à <strong>50</strong>, perd <strong>1 point par minute</strong>, gagne <strong>5 points par passe réussie</strong>, <strong>5 par dribble réussi</strong> et <strong>45 par but</strong>. Il est limité à <strong>0 minimum</strong>, mais n'a pas de plafond artificiel. Les autres événements apparaissent dans le journal sans ajouter de points.</p>
    <p>Le tracé relie les scores réellement calculés à chaque minute avec une interpolation lisse qui conserve les valeurs exactes. Le rose met en évidence les buts : ce n'est pas une mesure de vitesse, de fatigue ni une donnée GPS. Les tirs au but de la séance finale sont exclus.</p>
    <p><a href={profile.source.url} target="_blank" rel="noopener noreferrer">Source : StatsBomb Open Data ↗</a> · <a href={sourcePath}>Ancien JSON d'activité (v1) ↗</a></p>
    <p class="mw-source-credit">Données événementielles © StatsBomb / Hudl · Barème DataFoot v2 appliqué aux {rawEvents.length} actions de Mbappé. Les heures affichées suivent la convention StatsBomb (minute + 1).</p>
    <a class="mw-provider-brand" href="https://github.com/hudl/open-data" target="_blank" rel="noopener noreferrer" aria-label="StatsBomb, fournisseur des données de match">
     <img src="https://raw.githubusercontent.com/hudl/open-data/master/img/SB%20-%20Icon%20Lockup%20-%20Colour%20positive.png" loading="lazy" alt="Logo StatsBomb" width="164"/>
    </a>
   </div>
  </section>
  <details class="shell mw-event-log">
   <summary>Consulter les {rawEvents.length} événements de Mbappé <span>minute · action · impact</span></summary>
   <div class="mw-event-log-list">
    {rawEvents.map(a=><div class="mw-event-log-row">
     <span>{a.minute}′ {String(a.second).padStart(2,'0')}″</span>
     <strong>{actionLabel(a)}</strong>
     <small class={actionImpact(a)>0?'positive':''}>{actionImpact(a)>0?'+'+actionImpact(a):'0'}</small>
    </div>)}
   </div>
  </details>
 </div>
 <script is:inline define:vars={{series:timeline.map(({minute,activity,actions})=>({minute,activity,actions})), eventData:rawEvents, maxScore:axisMax, totalMinutes:profile.match.duration_minutes}}>
  (() => {
   const svg=document.getElementById('mw-chart'),hit=document.getElementById('mw-hit');
   const slider=document.getElementById('mw-minute'),cursor=document.getElementById('mw-cursor'),dot=document.getElementById('mw-dot');
   const out=document.getElementById('mw-readout'),count=document.getElementById('mw-count'),list=document.getElementById('mw-active-events');
   if(!svg||!hit||!slider||!cursor||!dot||!out||!count||!list)return;
   const labels={'Carry':'Conduite de balle','Ball Receipt*':'Réception','Ball Recovery':'Récupération','Pressure':'Pressing','Miscontrol':'Contrôle manqué','Block':'Contre','Foul Committed':'Faute commise'};
   const impact=a=>(a.kind==='Pass'&&a.outcome==='Complete')||(a.kind==='Dribble'&&a.outcome==='Complete')?5:a.kind==='Shot'&&a.outcome==='Goal'?45:0;
   const label=a=>a.kind==='Pass'?(a.outcome==='Complete'?'Passe réussie':'Passe non réussie'):a.kind==='Dribble'?(a.outcome==='Complete'?'Dribble réussi':'Dribble manqué'):a.kind==='Shot'?(a.outcome==='Goal'?'But':'Tir · '+a.outcome):(labels[a.kind]||a.kind);
   function show(value) {
    const minute=Math.max(0,Math.min(totalMinutes,Math.round(Number(value)||0))),p=series[minute];
    const cx=66+minute/totalMinutes*1104,cy=530-p.activity/maxScore*312;
    cursor.setAttribute('x1',String(cx));cursor.setAttribute('x2',String(cx));
    dot.setAttribute('cx',String(cx));dot.setAttribute('cy',String(cy));
    slider.value=String(minute);
    out.textContent=minute+'′ · Score '+p.activity;
    const active=eventData.filter(a=>a.minute===minute);
    count.textContent=active.length+' action(s) à cette minute';
    list.replaceChildren();
    if(!active.length){const empty=document.createElement('span');empty.textContent='Aucun événement enregistré à cette minute. Baisse naturelle de −1 (plancher 0).';list.append(empty);return;}
    for(const a of active) {
     const chip=document.createElement('span');chip.className='mw-action-chip'+(impact(a)?' is-positive':'');
     chip.textContent=String(a.second).padStart(2,'0')+'″ '+label(a)+(impact(a)?' +'+impact(a):'');
     list.append(chip);
    }
   }
   slider.addEventListener('input',()=>show(slider.value));
   const pointer=e=>{
    const rect=svg.getBoundingClientRect();
    show((((e.clientX-rect.left)/rect.width*1240)-66)/1104*totalMinutes);
   };
   hit.addEventListener('pointermove',pointer);
   hit.addEventListener('click',pointer);
   hit.addEventListener('keydown',e=>{
    if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();show(Number(slider.value)+(e.key==='ArrowRight'?1:-1));}
   });
   show(80);
  })();
 </script>
</BaseLayout>
