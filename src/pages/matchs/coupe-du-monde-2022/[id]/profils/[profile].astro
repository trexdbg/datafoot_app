---
import {games} from '../../../../../lib/explorer-data.mjs';
export function getStaticPaths(){return games.flatMap(game=>[{params:{id:String(game.id),profile:'france'},props:{matchId:game.id,profileKey:'france'}},...game.profiles.map(p=>({params:{id:String(game.id),profile:String(p.player.id)},props:{matchId:game.id,profileKey:String(p.player.id)}}))]);}
interface Props {matchId:number;profileKey:string}
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const {matchId,profileKey}=Astro.props;
const target=base+'/mondial-2022/matchs/'+matchId+'/'+(profileKey==='france'?'':'profil/?joueur='+profileKey);
---
<html lang="fr"><head><meta charset="utf-8"/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={'0;url='+target}/><link rel="canonical" href={target}/><title>Profil · nouvel Atlas DataFoot</title></head><body><p>Le profil se consulte dans l’explorateur interactif. <a href={target}>Ouvrir le nouveau profil →</a></p><script is:inline define:vars={{target}}>window.location.replace(target);</script></body></html>