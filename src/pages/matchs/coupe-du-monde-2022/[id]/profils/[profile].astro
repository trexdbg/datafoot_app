---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import {actionLabel,monotonePath,pulseWeight,PULSE_RULES} from '../../../../../lib/match-activity.mjs';
import {games,getProfile,matchHref,playerHref,mbappeId,matchTitle,formattedDate,teamGoals,playerGoals,pulsePeak,pulseAverage} from '../../../../../lib/explorer-data.mjs';
import '../../../../../styles/match-profile-detail.css';

export function getStaticPaths(){
 return games.flatMap(game=>[
  {params:{id:String(game.id),profile:'france'},props:{matchId:game.id,profileKey:'france'}},
  ...game.profiles.map(p=>({params:{id:String(game.id),profile:String(p.player.id)},props:{matchId:game.id,profileKey:String(p.player.id)}}))
 ]);
}
interface Props {matchId:number;profileKey:string}
type ChartPoint={minute:number;activity:number|null;impact:number|null;actions?:number;players?:number};
type RawEvent={minute:number;second:number;kind:string;outcome:string;playerId:number};
const {matchId,profileKey}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const game=games.find(g=>g.id===matchId)!;
const teamView=profileKey==='france';
const playerId=teamView?null:Number(profileKey);
const profile=teamView?null:getProfile(game,playerId!);
const name=teamView?'France · collectif':profile!.player.name;
const timeline:ChartPoint[]=teamView?game.team:profile!.timeline;
const goals:number[]=teamView?teamGoals(game):playerGoals(game,playerId!);
const peakActivity=pulsePeak(timeline,'activity');
const peakImpact=pulsePeak(timeline,'impact');
const average=pulseAverage(timeline,'activity');
const names=new Map<number,string>(game.players.map((p:{id:number;name:string})=>[p.id,p.name]));
const rawEvents:RawEvent[]=teamView
 ? game.actions.map((a:{p:number;m:number;s:number;k:string;o:string})=>({minute:a.m,second:a.s,kind:a.k,outcome:a.o,playerId:a.p}))
 : profile!.actions.map((a:{minute:number;second:number;kind:string;outcome:string})=>({minute:a.minute,second:a.second,kind:a.kind,outcome:a.outcome,playerId:profile!.player.id}));
const category=(kind:string)=>kind==='Pass'?'pass':kind==='Dribble'?'dribble':kind==='Shot'?'shot':'other';
const events=rawEvents.map(a=>({...a,label:actionLabel(a),weight:pulseWeight(a),category:category(a.kind),playerName:names.get(a.playerId)||'Joueur'}))
 .sort((a,b)=>a.minute-b.minute||a.second-b.second);
const passes=events.filter(a=>a.kind==='Pass'&&a.outcome==='Complete').length;
const dribbles=events.filter(a=>a.kind==='Dribble'&&a.outcome==='Complete').length;
const activeMinutes=timeline.filter(p=>p.activity!==null&&(p.actions??0)>0).length;
const firstAvailable=timeline.find(p=>p.activity!==null)?.minute??0;
const initialMinute=goals[0]??peakActivity?.minute??firstAvailable;
const initial=timeline[initialMinute]??timeline[firstAvailable];
const keyMoments=[
 ...goals.map(minute=>({minute,title:'⚽ But · '+minute+'′',kind:'goal'})),
 ...(peakActivity?[{minute:peakActivity.minute,title:'↗ Pic d’activité · '+peakActivity.minute+'′',kind:'activity'}]:[]),
 ...(peakImpact?[{minute:peakImpact.minute,title:'✦ Pic d’impact · '+peakImpact.minute+'′',kind:'impact'}]:[])
].filter((moment,index,array)=>array.findIndex(m=>m.minute===moment.minute)===index).slice(0,6);
const durationLabel=teamView?game.duration+'′':profile!.player.entry+'′ → '+(profile!.player.exit==null?game.duration+'′':' '+profile!.player.exit+'′');
const left=60,right=1055,top=48,bottom=325;
const x=(minute:number)=>left+minute/game.duration*(right-left);
const y=(score:number)=>bottom-Math.max(0,Math.min(100,score))/100*(bottom-top);
const seriesPaths=(metric:'activity'|'impact')=>{
 const segments:ChartPoint[][]=[];
 let segment:ChartPoint[]=[];
 for(const p of timeline){
  if(p[metric]===null){if(segment.length)segments.push(segment);segment=[];}
  else segment.push(p);
 }
 if(segment.length)segments.push(segment);
 return segments.map(points=>{
  const line=monotonePath(points.map(p=>({x:x(p.minute),y:y(p[metric]??0)})));
  const first=points[0],last=points.at(-1)!;
  return {line,area:line+' L '+x(last.minute)+' '+bottom+' L '+x(first.minute)+' '+bottom+' Z'};
 });
};
const tracks={activity:seriesPaths('activity'),impact:seriesPaths('impact')};
const xTicks=[...new Set([0,15,30,45,60,75,90,105,120,game.duration].filter(t=>t<=game.duration))];
const stacks=new Map<number,number>();
const rail=(teamView?[...events].sort((a,b)=>a.minute-b.minute||b.weight.activity-a.weight.activity||a.second-b.second):events).flatMap(a=>{
 const stack=stacks.get(a.minute)||0;
 stacks.set(a.minute,stack+1);
 if(stack>=(teamView?6:10))return [];
 return {minute:a.minute,cy:425-stack*5,kind:a.kind==='Shot'&&a.outcome==='Goal'?'goal':a.weight.impact>=2?'strong':a.weight.activity>=1?'active':'quiet',label:a.minute+'′ '+String(a.second).padStart(2,'0')+'″ · '+(teamView?a.playerName+' · ':'')+a.label};
});
const clientSeries=timeline.map(p=>({activity:p.activity,impact:p.impact,players:p.players??null}));
const clientEvents=events.map(a=>({minute:a.minute,second:a.second,label:a.label,playerName:teamView?a.playerName:null,category:a.category,activityWeight:a.weight.activity,impactWeight:a.weight.impact,goal:a.kind==='Shot'&&a.outcome==='Goal'}));
const urlRoot=base+'/matchs/coupe-du-monde-2022/'+game.id+'/profils/';
---
<BaseLayout title={name+' · DataFoot Pulse | '+matchTitle(game)} description={'Profil DataFoot Pulse : activité, impact indicatif et détail de chaque action pour '+name+' · '+matchTitle(game)+'.'} canonicalPath={urlRoot+profileKey+'/'}>
<div class="md-root">
 <main class="shell md-wrap">
  <nav class="md-breadcrumb" aria-label="Fil d’Ariane"><a href={base+'/equipes/france/'}>France · 2022</a><span>/</span><a href={matchHref(base,game)}>{matchTitle(game)}</a><span>/</span><span>Pulse V3</span></nav>
  <header class="md-header">
   <div><p class="md-kicker">DATAFOOT PULSE <span class="md-version">V3</span> · {formattedDate(game.date)}</p>
    <h1>{teamView?'Le rythme collectif.':'Le match de'}<br/><em>{teamView?'France':name+'.'}</em></h1>
    <p>{matchTitle(game)} · {teamView?'Une seule courbe collective, indépendante des profils individuels.':'Un joueur, son rythme, ses moments de rupture. Aucune courbe d’équipe superposée.'}</p>
   </div>
   <div class="md-hero-mark"><span>MINUTES COUVERTES</span><strong>{durationLabel}</strong><small>{events.length.toLocaleString('fr-FR')} événements · StatsBomb</small></div>
  </header>
  <nav class="md-links" aria-label="Explorer"><a href={matchHref(base,game)}>← Retour au match</a>{!teamView&&<a href={playerHref(base,playerId!)}>Autres matchs du joueur →</a>}{teamView&&<a href={playerHref(base,mbappeId)}>Voir Mbappé →</a>}</nav>

  <div class="md-stat-row" aria-label="Chiffres clés">
   <div><span>PIC D’ACTIVITÉ</span><strong>{peakActivity?.activity?.toFixed(0)??'—'}<small>/100</small></strong><p>{peakActivity?.minute??0}′ minute</p></div>
   <div><span>PIC D’IMPACT</span><strong>{peakImpact?.impact?.toFixed(0)??'—'}<small>/100</small></strong><p>{peakImpact?.minute??0}′ minute · indicatif</p></div>
   <div><span>ACTIVITÉ MOYENNE</span><strong>{average.toFixed(0)}<small>/100</small></strong><p>Sur les minutes jouées</p></div>
   <div><span>MINUTES ACTIVES</span><strong>{activeMinutes}</strong><p>{goals.length} but{goals.length>1?'s':''} · {passes} passes réussies</p></div>
  </div>

  <section class="md-report" aria-labelledby="md-chart-heading">
   <div class="md-report-top">
    <div><p class="md-kicker">LECTURE DU MATCH</p><h2 id="md-chart-heading">La signature des 90 minutes.</h2><p id="md-mode-help">Activité : quantité d’actions récente. Chaque action crée une onde qui décroît avec le temps.</p></div>
    <div class="md-mode-switch" role="group" aria-label="Choisir la lecture du match">
     <button type="button" class="md-mode active" data-mode="activity" aria-pressed="true">◉ Activité</button>
     <button type="button" class="md-mode" data-mode="impact" aria-pressed="false">✦ Impact</button>
    </div>
   </div>
   <div class="md-chart-scroll" tabindex="0" aria-label="Faire défiler le graphique horizontalement sur petit écran">
    <svg id="md-chart" viewBox="0 0 1110 463" role="img" aria-labelledby="md-svg-title md-svg-description">
     <title id="md-svg-title">Courbes DataFoot Pulse pour {name} · {matchTitle(game)}</title>
     <desc id="md-svg-description">Courbe cyan d'activité ou courbe ambrée d'impact indicatif sur une échelle fixe de 0 à 100, sans comparaison avec une autre équipe. Sous l'axe X figurent les points de chaque action.</desc>
     <rect width="1110" height="463" fill="#081b30"/>
     {[0,25,50,75,100].map(v=><g><line class="md-gridline" x1={left} x2={right} y1={y(v)} y2={y(v)}/><text class="md-y-tick" x="48" y={y(v)+5} text-anchor="end">{v}</text></g>)}
     {xTicks.map(t=><line class="md-gridline vertical" x1={x(t)} x2={x(t)} y1={top} y2={bottom}/>)}
     <text class="md-svg-label" x={left} y="27">PULSE · INDICE /100</text>
     {game.duration>90&&<g><line x1={x(90)} x2={x(90)} y1={top} y2={bottom} stroke="#b5d5e6" stroke-dasharray="5 7" opacity=".55"/><text x={x(90)+10} y="65" class="md-extension">TEMPS ADDITIONNEL / PROLONGATIONS</text></g>}
     {(['activity','impact'] as const).map(metric=><g class="md-series" data-series={metric} hidden={metric!=='activity'}>
      {tracks[metric].map(path=><g><path d={path.area} fill={metric==='activity'?'#63ccff':'#ffd07d'} fill-opacity=".13"/><path d={path.line} fill="none" stroke={metric==='activity'?'#70dcff':'#ffc578'} stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" class="md-main-line"/></g>)}
      {goals.map(minute=>timeline[minute]?.[metric]!=null?<g><circle cx={x(minute)} cy={y(timeline[minute][metric]!)} r="7" fill="#ff6996" stroke="#fff3f8" stroke-width="2.6"/><title>But à la {minute}′ · repère de l’action</title></g>:null)}
     </g>)}
     <line class="md-axis-line" x1={left} x2={right} y1={bottom} y2={bottom}/>
     {xTicks.map(t=><g><line class="md-axis-tick" x1={x(t)} x2={x(t)} y1={bottom} y2={bottom+7}/><text class="md-x-tick" x={x(t)} y="353" text-anchor="middle">{t}′</text></g>)}
     <text class="md-rail-label" x={left} y="380">CHRONOLOGIE DES ACTIONS · {teamView?'6 REPÈRES MAX. PAR MINUTE':'1 POINT PAR ACTION'}</text>
     <line x1={left} x2={right} y1="426" y2="426" stroke="#8db2d0" stroke-opacity=".3"/>
     {rail.map(dot=><circle class:list={['md-action-dot',dot.kind]} cx={x(dot.minute)} cy={dot.cy} r={dot.kind==='goal'?4.6:2.8} data-minute={dot.minute} role="button" tabindex="0" aria-label={dot.label}><title>{dot.label}</title></circle>)}
     <line id="md-cursor" x1={x(initialMinute)} x2={x(initialMinute)} y1={top} y2={bottom} stroke="#d9eeff" stroke-dasharray="5 6" stroke-width="1.7" opacity=".8" pointer-events="none"/>
     <circle id="md-cursor-dot" cx={x(initialMinute)} cy={y(initial.activity??0)} r="7" fill="#fff" stroke="#61d9ff" stroke-width="3" pointer-events="none"/>
     <rect id="md-hit" x={left} y={top} width={right-left} height={bottom-top} fill="transparent" tabindex="0" aria-label="Explorer la courbe avec la souris ou les flèches du clavier"/>
    </svg>
   </div>
   <div class="md-rail-help"><span><i class="md-legend-dot"></i> Autres actions</span><span><i class="md-legend-dot active"></i> Actions remarquables</span><span><i class="md-legend-dot goal"></i> Buts</span><span class="md-rail-hint">Cliquer sur un point ou déplacer le curseur pour lire les événements.</span></div>
   <div class="md-moments"><strong>MOMENTS CLÉS</strong>{keyMoments.map(m=><button type="button" data-jump-minute={m.minute} class:list={['md-moment',m.kind]}>{m.title} <span>↗</span></button>)}</div>
   <div class="md-inspector" id="md-inspector">
    <div class="md-readout">
     <div><span>EXPLORER LA MINUTE</span><output id="md-readout">{initialMinute}′</output></div>
     <div class="md-readout-metrics"><span>Activité <strong id="md-value-activity">{initial.activity?.toFixed(0)??'—'}</strong></span><span>Impact <strong id="md-value-impact">{initial.impact?.toFixed(0)??'—'}</strong></span></div>
    </div>
    <input id="md-minute" type="range" min="0" max={game.duration} step="1" value={initialMinute} aria-label="Sélectionner une minute"/>
    <div class="md-step-controls"><button type="button" data-step="-1">← Minute précédente</button><span id="md-action-count"></span><button type="button" data-step="1">Minute suivante →</button></div>
    <div class="md-minute-actions" id="md-minute-actions" aria-live="polite"></div>
   </div>
  </section>
  <section class="md-after-grid">
   <div class="md-reading"><p class="md-kicker">COMMENT LIRE LA COURBE ?</p><h2>Une impulsion.<br/><em>Pas un cumul infini.</em></h2><p>Chaque passe, dribble, tir ou récupération influence le profil, puis son effet s’estompe naturellement. Une séquence intense fait monter la courbe ; une période calme la fait redescendre.</p>
    <div class="md-rule-row"><span>Mémoire courte <strong>{PULSE_RULES.shortHalfLife} min</strong></span><span>Mémoire longue <strong>{PULSE_RULES.longHalfLife} min</strong></span><span>Échelle fixe <strong>0–100</strong></span></div>
    <p class="md-disclaimer"><strong>Important :</strong> l’impact est ici un indicateur heuristique de qualité d’action, pas une mesure xT, VAEP ou une probabilité de marquer. Faute de contexte spatial dans nos fichiers simplifiés, il ne remplace pas une évaluation tactique. Les buts sont signalés, mais n’ajoutent pas automatiquement 45 points à l’activité.</p>
   </div>
   <div class="md-quick-facts"><p class="md-kicker">LES ACTIONS DU MATCH</p><div><span>Passes réussies</span><strong>{passes}</strong></div><div><span>Dribbles réussis</span><strong>{dribbles}</strong></div><div><span>Buts</span><strong>{goals.length}</strong></div><div><span>Total des événements</span><strong>{events.length.toLocaleString('fr-FR')}</strong></div></div>
  </section>
  <details class="md-log" id="md-event-log">
   <summary><span>Journal complet des actions</span><small>{events.length.toLocaleString('fr-FR')} événements · recherche par catégorie et minute</small></summary>
   <div class="md-filter-row" role="group" aria-label="Filtrer les événements"><button type="button" class="active" aria-pressed="true" data-event-filter="all">Tout</button><button type="button" aria-pressed="false" data-event-filter="pass">Passes</button><button type="button" aria-pressed="false" data-event-filter="dribble">Dribbles</button><button type="button" aria-pressed="false" data-event-filter="shot">Tirs / buts</button><button type="button" aria-pressed="false" data-event-filter="other">Autres</button><span id="md-filter-count">{events.length} événements</span></div>
   <div class="md-log-list">
    {events.map(a=><button type="button" class="md-log-row" data-jump-minute={a.minute} data-category={a.category}>
     <span>{a.minute}′ {String(a.second).padStart(2,'0')}″</span><span>{teamView&&<small>{a.playerName}</small>}{a.label}</span>
     <strong>{a.weight.activity.toLocaleString('fr-FR',{maximumFractionDigits:2})} <small>impulsion</small></strong>
    </button>)}
   </div>
  </details>
  <p class="md-source">Source : <a href={game.source} rel="noopener noreferrer" target="_blank">StatsBomb Open Data / Hudl ↗</a> · Matchs de France, Coupe du monde 2022. Temps additionnel et prolongations affichés lorsqu’ils figurent dans les données ; tirs au but d’après-match exclus.</p>
 </main>
</div>
<script is:inline define:vars={{series:clientSeries,eventData:clientEvents,totalMinutes:game.duration,firstMinute:initialMinute,teamMode:teamView}}>
(() => {
 const svg=document.getElementById('md-chart'),hit=document.getElementById('md-hit');
 const cursor=document.getElementById('md-cursor'),dot=document.getElementById('md-cursor-dot');
 const slider=document.getElementById('md-minute'),readout=document.getElementById('md-readout');
 const activity=document.getElementById('md-value-activity'),impact=document.getElementById('md-value-impact');
 const count=document.getElementById('md-action-count'),list=document.getElementById('md-minute-actions');
 if(!svg||!hit||!slider||!cursor||!dot||!readout||!activity||!impact||!count||!list)return;
 let mode='activity', selected=firstMinute;
 const byMinute=new Map();
 for(const a of eventData){if(!byMinute.has(a.minute))byMinute.set(a.minute,[]);byMinute.get(a.minute).push(a);}
 const fmt=n=>String(n).padStart(2,'0');
 function setMinute(value){
  const minute=Math.max(0,Math.min(totalMinutes,Math.round(Number(value)||0)));
  selected=minute; slider.value=String(minute);
  const point=series[minute],location=60+minute/totalMinutes*995;
  cursor.setAttribute('x1',String(location));cursor.setAttribute('x2',String(location));
  if(point?.[mode]==null)dot.setAttribute('visibility','hidden');
  else{
   dot.setAttribute('visibility','visible');dot.setAttribute('cx',String(location));
   dot.setAttribute('cy',String(325-point[mode]/100*277));
  }
  readout.textContent=minute+'′';
  activity.textContent=point?.activity==null?'—':Math.round(point.activity)+'/100';
  impact.textContent=point?.impact==null?'—':Math.round(point.impact)+'/100';
  const items=byMinute.get(minute)||[];
  count.textContent=items.length+' action'+(items.length!==1?'s':'')+(teamMode&&point?.players?' · '+point.players+' joueurs':'');
  list.replaceChildren();
  if(!items.length){
   const empty=document.createElement('span');empty.className='md-empty';
   empty.textContent=point?.activity==null?'Hors du terrain à cette minute.':'Aucune action : les impulsions antérieures s’atténuent.';
   list.append(empty);return;
  }
  for(const a of items){
   const chip=document.createElement('span');
   chip.className='md-action-chip'+(a.goal?' goal':a.impactWeight>=2?' positive':'');
   const weight=mode==='activity'?a.activityWeight:a.impactWeight;
   chip.textContent=fmt(a.second)+'″ · '+(teamMode?a.playerName+' · ':'')+a.label+' · impulsion '+(weight>0?'+':'')+weight.toLocaleString('fr-FR',{maximumFractionDigits:2});
   list.append(chip);
  }
 }
 function setMode(next){
  mode=next;
  svg.querySelectorAll('[data-series]').forEach(el=>{el.hidden=el.dataset.series!==next;});
  document.querySelectorAll('[data-mode]').forEach(button=>{
   const active=button.dataset.mode===next;
   button.classList.toggle('active',active);button.setAttribute('aria-pressed',String(active));
  });
  dot.setAttribute('stroke',next==='activity'?'#61d9ff':'#ffc578');
  document.getElementById('md-mode-help').textContent=next==='activity'
   ?'Activité : quantité d’actions récente. Chaque action crée une onde qui décroît avec le temps.'
   :'Impact indicatif : valorisation expérimentale des actions réussies, tirs et buts. Ce n’est pas un modèle xT.';
  setMinute(selected);
 }
 function pointer(event){const rect=svg.getBoundingClientRect();setMinute(((event.clientX-rect.left)/rect.width*1110-60)/995*totalMinutes);}
 slider.addEventListener('input',()=>setMinute(slider.value));
 hit.addEventListener('pointermove',pointer);
 hit.addEventListener('click',pointer);
 hit.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();setMinute(selected+(e.key==='ArrowRight'?1:-1));}});
 svg.querySelectorAll('.md-action-dot').forEach(marker=>{
  const open=()=>{setMinute(marker.dataset.minute);document.getElementById('md-inspector')?.scrollIntoView({behavior:'smooth',block:'center'});};
  marker.addEventListener('click',open);
  marker.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}});
 });
 document.querySelectorAll('[data-jump-minute]').forEach(button=>button.addEventListener('click',()=>{
  setMinute(button.dataset.jumpMinute);
  document.getElementById('md-inspector')?.scrollIntoView({behavior:'smooth',block:'center'});
 }));
 document.querySelectorAll('[data-step]').forEach(button=>button.addEventListener('click',()=>setMinute(selected+Number(button.dataset.step))));
 document.querySelectorAll('[data-mode]').forEach(button=>button.addEventListener('click',()=>setMode(button.dataset.mode)));
 const rows=[...document.querySelectorAll('.md-log-row')];
 document.querySelectorAll('[data-event-filter]').forEach(button=>button.addEventListener('click',()=>{
  const filter=button.dataset.eventFilter;let shown=0;
  for(const row of rows){const visible=filter==='all'||row.dataset.category===filter;row.hidden=!visible;if(visible)shown++;}
  for(const other of document.querySelectorAll('[data-event-filter]')){
   const active=other===button;other.classList.toggle('active',active);other.setAttribute('aria-pressed',String(active));
  }
  document.getElementById('md-filter-count').textContent=shown+' événements';
 }));
 setMode('activity');
})();
</script>
</BaseLayout>
