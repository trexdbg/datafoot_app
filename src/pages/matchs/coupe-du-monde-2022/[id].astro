---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActivityMiniChart from '../../../components/ActivityMiniChart.astro';
import {games,pulsePeak,mbappeId,getProfile,matchHref,playerHref,formattedDate,matchTitle,opposingTeam,country,playerGoals,teamGoals,matchProfileHref} from '../../../lib/explorer-data.mjs';
import '../../../styles/match-explorer.css';
export function getStaticPaths(){
 return games.map(game=>({params:{id:String(game.id)},props:{matchId:game.id}}));
}
interface Props {matchId:number}
const {matchId}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const game=games.find(g=>g.id===matchId)!;
const selected=getProfile(game,mbappeId);
const spotlight=selected?pulsePeak(selected.timeline):null;
const players=[...game.profiles].sort((a,b)=>a.player.id===mbappeId?-1:b.player.id===mbappeId?1:a.player.name.localeCompare(b.player.name,'fr'));
const index=games.findIndex(g=>g.id===game.id);
const prev=games[index-1],next=games[index+1];
---
<BaseLayout title={matchTitle(game)+' · profils d’activité | DataFoot'} description={'Courbes DataFoot Pulse des '+game.profiles.length+' joueurs ayant participé au match contre '+opposingTeam(game)} canonicalPath={base+'/matchs/coupe-du-monde-2022/'+game.id+'/'}>
<div class="ax-root"><div class="shell ax-wrap">
 <nav class="ax-breadcrumb" aria-label="Fil d'Ariane"><a href={base+'/'}>DATAFOOT</a><span>/</span><a href={base+'/equipes/france/'}>FRANCE · 2022</a><span>/</span>{opposingTeam(game)}</nav>
 <div class="ax-header">
  <div><p class="ax-eyebrow">{formattedDate(game.date)} · COUPE DU MONDE 2022</p>
   <h1>{country(game.home)} <em>{game.homeScore}–{game.awayScore}</em><br/>{country(game.away)}</h1>
   <p>Une courbe d’activité pour chacun des {game.profiles.length} joueurs, sans superposition avec l’équipe. Choisis un joueur pour explorer ses actions et ses moments forts.</p>
  </div>
  <div class="ax-header-stat"><strong>{game.duration}′</strong><span>DURÉE COUVERTE</span><small>{game.actions.length} événements français</small></div>
 </div>
 <div class="ax-subnav"><a href={base+'/equipes/france/'}>← Sept matchs de France</a><a href={playerHref(base,mbappeId)}>Parcours de Mbappé</a><a href={matchProfileHref(base,game)}>Collectif français ↗</a><a class="active" href="#ax-all-players">Tous les joueurs ↓</a></div>
 {selected && <section class="ax-feature-card ax-spotlight">
  <div class="ax-spotlight-intro"><div><p class="ax-eyebrow">À LA UNE · PULSE V3</p><h2>Mbappé, minute par minute.</h2>
  <p>Un graphique, ses propres actions. La courbe reflète les phases de présence dans le jeu — pas la performance de l’équipe.</p></div>
  <div class="ax-spotlight-peak"><span>POINT CULMINANT</span><strong>{spotlight?.activity?.toFixed(0)??'—'}</strong><small>à {spotlight?.minute??0}′</small></div></div>
  <ActivityMiniChart duration={game.duration} timeline={selected.timeline} goals={playerGoals(game,mbappeId)} caption={'Pulse de Mbappé · '+matchTitle(game)} />
  <div class="ax-feature-info"><span class="ax-dot blue"></span> Activité de Mbappé <span class="ax-dot goal"></span> Buts <a class="ax-detail-link" href={matchProfileHref(base,game,mbappeId)}>Explorer son profil →</a></div>
 </section>}
 <div id="ax-all-players" class="ax-section-title"><div><p class="ax-eyebrow">DÉTAILS INDIVIDUELS</p><h2>Les joueurs du match.</h2><p>Les profils individuels sont affichés seuls sur une échelle 0–100. Les points sous l’axe X indiquent les minutes avec actions. Ouvre une courbe pour connaître chaque événement.</p></div><span>{players.length} JOUEURS</span></div>
 <div class="ax-search-row"><label for="ax-filter">Trouver un joueur</label><input id="ax-filter" type="search" placeholder="Nom du joueur… ex. Griezmann" autocomplete="off"/><span id="ax-filter-count">{players.length} joueurs</span></div>
 <div class="ax-card-grid ax-player-grid">
 {players.map(profile=>{
  const goals=playerGoals(game,profile.player.id);
  const passed=profile.actions.filter(a=>a.kind==='Pass'&&a.outcome==='Complete').length;
  const peak=pulsePeak(profile.timeline);
  return <article class="ax-match-card ax-player-card" data-search={profile.player.name.toLocaleLowerCase('fr')}>
   <div class="ax-card-kicker">{profile.player.entry===0?'TITULAIRE':'ENTRÉE À '+profile.player.entry+'′'} · {profile.actions.length} ACTIONS</div>
   <a href={matchProfileHref(base,game,profile.player.id)} class="ax-match-title">{profile.player.name} <span>↗</span></a>
   <p class="ax-card-meta">{passed} passes réussies · {goals.length} but{goals.length>1?'s':''}</p>
   <div class="ax-pulse-metrics"><span>Pic <strong>{peak?.activity?.toFixed(0)??'—'}</strong> <small>{peak?.minute??0}′</small></span><span>Impact / activité <small>voir détail</small></span></div>
   <ActivityMiniChart duration={game.duration} timeline={profile.timeline} goals={goals} caption={'Pulse de '+profile.player.name} />
   <div class="ax-card-footer"><a class="ax-detail-link" href={matchProfileHref(base,game,profile.player.id)}>Détail des actions <span>↗</span></a><a href={playerHref(base,profile.player.id)+'#match-'+game.id}>Autres matchs →</a></div>
  </article>;
 })}
 </div>
 <p class="ax-no-results" id="ax-empty" hidden>Aucun joueur correspondant à cette recherche.</p>
 <div class="ax-match-pager"><span>{prev?<a href={matchHref(base,prev)}>← {opposingTeam(prev)}</a>:'Début du parcours'}</span><a href={base+'/equipes/france/'}>Liste des 7 matchs</a><span>{next?<a href={matchHref(base,next)}>{opposingTeam(next)} →</a>:'Fin du parcours'}</span></div>
 <div class="ax-method"><strong>DataFoot Pulse V3.</strong> Les actions alimentent une mémoire de 3 et 10 minutes. Toutes les courbes individuelles utilisent le même indice d’activité 0–100. L’impact indicatif est consultable dans chaque profil, sans comparer le joueur au collectif. Le collectif reste disponible comme vue autonome.</div>
 <p class="ax-source">Données événementielles © StatsBomb / Hudl · <a href={game.source} target="_blank" rel="noopener noreferrer">Voir le flux public original ↗</a>. Les tirs au but d’après-match ne sont pas pris en compte.</p>
</div></div>
<script is:inline>
 (()=>{const search=document.getElementById('ax-filter'),cards=[...document.querySelectorAll('.ax-player-card')],count=document.getElementById('ax-filter-count'),empty=document.getElementById('ax-empty');if(!search)return;search.addEventListener('input',()=>{const q=search.value.trim().toLocaleLowerCase('fr');let visible=0;for(const card of cards){const match=card.dataset.search?.includes(q);card.hidden=!match;if(match)visible++;}count.textContent=visible+' joueur'+(visible>1?'s':'');empty.hidden=visible!==0;});})();
</script>
</BaseLayout>
