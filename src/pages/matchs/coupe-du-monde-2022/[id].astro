---
import {games} from '../../../lib/explorer-data.mjs';
export function getStaticPaths(){return games.map(game=>({params:{id:String(game.id)},props:{matchId:game.id}}));}
interface Props {matchId:number}
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const target=base+'/mondial-2022/matchs/'+Astro.props.matchId+'/';
---
<html lang="fr"><head><meta charset="utf-8"/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={'0;url='+target}/><link rel="canonical" href={target}/><title>Match · nouvel Atlas DataFoot</title></head><body><p>Ce match est disponible avec des profils individuels interactifs. <a href={target}>Explorer le match →</a></p><script is:inline define:vars={{target}}>window.location.replace(target);</script></body></html>