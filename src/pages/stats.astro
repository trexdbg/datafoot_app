---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlayerTable from '../components/PlayerTable.astro';
import stats from '../data/stats.json';
import { SORARE_REFERRAL_URL } from '../lib/referrals';

interface MatchRow { match_id:number|null; league:string; season:number; kickoff:string|null; home:string; away:string; home_goals:number|null; away_goals:number|null; finished:boolean; source:string; source_url:string; fetched_at:string; }
interface PlayerProfile {
  player:string; matched_from:string; match_confidence:number; club:string; position:string;
  football_metrics?: {
    appearances:number; minutes:number; pass_accuracy:number|null;
    accurate_pass_per90:number; final_third_passes_per90:number;
    dribbles_won_per90:number; duels_won_per90:number; shots_per90:number;
  };
}

const updated = new Date(stats.generated_at);
const players = stats.top_players.slice(0, 30).filter((player) => player.minutes >= 90);
const referenceDate = new Date(stats.generated_at);
const maxDistanceMs = 45 * 24 * 60 * 60 * 1000;
const matches = (stats.recent_matches as MatchRow[])
  .filter((match) => {
    if (!match.kickoff) return false;
    const kickoff = new Date(match.kickoff);
    return Number.isFinite(kickoff.valueOf()) && Math.abs(kickoff.valueOf() - referenceDate.valueOf()) <= maxDistanceMs;
  })
  .sort((a, b) => new Date(a.kickoff ?? 0).valueOf() - new Date(b.kickoff ?? 0).valueOf())
  .slice(0, 12);
const profiles = (((stats as any).player_profiles ?? (stats as any).sorare_players ?? []) as PlayerProfile[])
  .filter((player) => player.football_metrics && player.match_confidence >= .82);
const sourceStatus = (stats as any).source_status ?? {};
const statusLabel = (name: string) => {
  const status = sourceStatus[name]?.status ?? 'pending';
  if (status === 'active') return 'Actif';
  if (status === 'unavailable') return 'Indisponible';
  if (status === 'not_configured') return 'Non configuré';
  return 'En attente';
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = Astro.site ?? new URL('https://trexdbg.github.io');
const dataUrl = new URL(`${base}/data/stats.json`, siteOrigin).toString();
const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `DataFoot — dataset football saison ${stats.season}`,
  description: 'Statistiques football normalisées : xG, xA, tirs, passes, dribbles, duels et matchs.',
  url: new URL(`${base}/stats/`, siteOrigin).toString(),
  dateModified: stats.generated_at,
  inLanguage: 'fr-FR',
  creator: { '@type': 'Organization', name: 'DataFoot' },
  variableMeasured: ['buts', 'passes décisives', 'xG', 'xA', 'tirs', 'passes réussies', 'dribbles réussis', 'duels gagnés'],
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: dataUrl }],
};
---
<BaseLayout
  title="Données football : xG, passes, dribbles et matchs | DataFoot"
  description={`Dataset DataFoot saison ${stats.season} : xG, xA, tirs et statistiques de match détaillées pour ${stats.player_count} joueurs.`}
  jsonLd={datasetSchema}
>
  <section class="shell page-head page-head-grid">
    <div><p class="eyebrow">DATA</p><h1>Les données derrière les analyses.</h1></div>
    <p>Saison {stats.season} · {stats.player_count.toLocaleString('fr-FR')} joueurs · mise à jour {updated.toLocaleString('fr-FR')}.</p>
  </section>

  <section class="shell section data-dashboard">
    <div class="stat-strip">
      <div><span>Sources</span><strong>{stats.sources.length}</strong><small>actives</small></div>
      <div><span>Joueurs</span><strong>{stats.player_count.toLocaleString('fr-FR')}</strong><small>observations</small></div>
      <div><span>Profils</span><strong>{profiles.length}</strong><small>enrichis en stats de match</small></div>
    </div>

    <div class="source-status-grid">
      {['Understat', 'OpenLigaDB', 'Sorare'].map((name) => (
        <div class="source-status-card"><span class:list={['status-dot', sourceStatus[name]?.status === 'active' && 'ok']}></span><div><strong>{name}</strong><p>{statusLabel(name)}</p></div></div>
      ))}
    </div>

    <div class="section-heading data-heading"><div><p class="eyebrow">PERFORMANCE</p><h2>xG par 90</h2></div><p>Joueurs avec au moins 90 minutes observées.</p></div>
    {players.length > 0 ? <PlayerTable players={players} /> : <div class="empty-state"><p>Pas encore assez de données.</p></div>}

    <div class="section-heading data-heading"><div><p class="eyebrow">PROFILS JOUEURS</p><h2>Stats de match récentes</h2></div><p>Passes, dribbles, duels et tirs ramenés à 90 minutes.</p></div>
    {profiles.length > 0 ? (
      <div class="table-wrap"><table><thead><tr><th>Joueur</th><th>Poste</th><th>Min.</th><th>Passes/90</th><th>Dernier tiers/90</th><th>Dribbles/90</th><th>Duels/90</th><th>Tirs/90</th><th>Source</th></tr></thead><tbody>
        {profiles.slice(0, 20).map((player) => {
          const m = player.football_metrics!;
          return (
            <tr>
              <td><strong>{player.player}</strong><br/><small>{player.club || '—'}</small></td>
              <td>{player.position || '—'}</td>
              <td>{m.minutes}</td>
              <td>{m.accurate_pass_per90.toFixed(1)}</td>
              <td>{m.final_third_passes_per90.toFixed(1)}</td>
              <td>{m.dribbles_won_per90.toFixed(2)}</td>
              <td>{m.duels_won_per90.toFixed(2)}</td>
              <td>{m.shots_per90.toFixed(2)}</td>
              <td><a href={SORARE_REFERRAL_URL} rel="sponsored nofollow noreferrer">Source ↗</a></td>
            </tr>
          );
        })}
      </tbody></table></div>
    ) : <div class="empty-state"><p>Les profils détaillés apparaîtront après la prochaine collecte.</p></div>}

    <div class="section-heading data-heading"><div><p class="eyebrow">MATCHS</p><h2>Récents et à venir</h2></div></div>
    {matches.length > 0 ? (
      <div class="table-wrap"><table><thead><tr><th>Date</th><th>Match</th><th>Score</th><th>État</th></tr></thead><tbody>
      {matches.map((match) => (<tr><td>{match.kickoff ? new Date(match.kickoff).toLocaleDateString('fr-FR') : '—'}</td><td><strong>{match.home}</strong> — {match.away}</td><td>{match.home_goals === null || match.away_goals === null ? '—' : `${match.home_goals} - ${match.away_goals}`}</td><td>{match.finished ? 'Terminé' : 'À venir'}</td></tr>))}
      </tbody></table></div>
    ) : <div class="empty-state"><p>Aucun match proche de la date actuelle.</p></div>}

    <div class="raw-data-link"><span>Données brutes et provenance</span><a href={`${base}/data/stats.json`}>JSON public →</a></div>
  </section>
</BaseLayout>
