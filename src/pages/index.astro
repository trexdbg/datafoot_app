---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import stats from '../data/stats.json';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 6);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;
const updated = new Date(stats.generated_at);
const liveSources = Object.entries((stats as any).source_status ?? {}).filter(([, value]: any) => value?.status === 'active').length;
const editorialPlan = ((stats as any).editorial_plan ?? []) as Array<{selector?: string}>;
const aiSelected = editorialPlan.some((pick) => pick.selector?.startsWith('gemini:'));
---
<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy-wrap">
      <div class="signal-line"><span class="pulse"></span> DATASET ACTUALISÉ · {updated.toLocaleDateString('fr-FR')}</div>
      <p class="eyebrow">FOOTBALL / DATA / SIGNAL</p>
      <h1>Lire le football<br /><em>par les données.</em></h1>
      <p class="hero-copy">
        xG, xA, tirs, efficacité et tendances : DataFoot transforme des statistiques sourcées
        en analyses compréhensibles, vérifiables et conçues pour aller au-delà du score brut.
      </p>
      <div class="actions">
        <a class="button primary" href={url('/articles/')}>Voir les analyses <span>↗</span></a>
        <a class="button ghost" href={url('/stats/')}>Explorer les données</a>
      </div>
    </div>

    <aside class="signal-board" aria-label="État du pipeline DataFoot">
      <div class="board-head"><span>DATAFOOT / LIVE</span><span class="status-pill">ONLINE</span></div>
      <div class="board-number">{stats.player_count.toLocaleString('fr-FR')}</div>
      <div class="board-label">joueurs observés cette saison</div>
      <div class="board-grid">
        <div><span>Ligues</span><strong>{stats.leagues.length}</strong></div>
        <div><span>Sources actives</span><strong>{liveSources}</strong></div>
        <div><span>Candidats</span><strong>{(stats as any).candidate_count ?? '—'}</strong></div>
        <div><span>Sélection</span><strong>{aiSelected ? 'IA' : 'Fallback'}</strong></div>
      </div>
      <div class="board-foot">Dernière génération · {updated.toLocaleString('fr-FR')}</div>
    </aside>
  </section>

  <section class="ticker" aria-label="Principes DataFoot">
    <div class="shell ticker-inner">
      <span>DONNÉES SOURCÉES</span><i>•</i><span>ANGLES SÉLECTIONNÉS</span><i>•</i><span>FAITS VÉRIFIABLES</span><i>•</i><span>MÉTHODOLOGIE PUBLIQUE</span>
    </div>
  </section>

  <section class="shell section">
    <div class="section-heading editorial-heading">
      <div>
        <p class="eyebrow">SIGNALS RETENUS</p>
        <h2>Dernières analyses</h2>
      </div>
      <a class="text-link" href={url('/articles/')}>Toutes les analyses →</a>
    </div>

    <div class="article-grid editorial-grid">
      {articles.map((article, index) => (
        <article class:list={['card', index === 0 && 'card-featured']}>
          <div class="card-index">0{index + 1}</div>
          <div class="card-meta">
            <span>{article.data.league.replaceAll('_', ' ')}</span>
            <time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('fr-FR')}</time>
          </div>
          <h3><a href={url(`/articles/${article.id}/`)}>{article.data.title}</a></h3>
          <p>{article.data.description}</p>
          <div class="card-footer">
            <span>{article.data.player} · {article.data.team}</span>
            <span class="score-chip">signal {Math.round(article.data.storyScore)}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="shell evidence-section">
    <div class="evidence-intro">
      <p class="eyebrow">POURQUOI DATAFOOT</p>
      <h2>Un article doit pouvoir être remonté jusqu’à ses données.</h2>
      <p>Chaque analyse expose sa source, ses métriques principales et le cadre méthodologique utilisé. Les chiffres sont calculés avant la rédaction.</p>
      <a class="text-link" href={url('/methodologie/')}>Voir la méthodologie complète →</a>
    </div>
    <div class="evidence-list">
      <div><span>01</span><div><strong>Collecter</strong><p>Les sources sont interrogées indépendamment et peuvent échouer sans casser le pipeline.</p></div></div>
      <div><span>02</span><div><strong>Normaliser</strong><p>Les données sont converties dans un schéma commun avec provenance et horodatage.</p></div></div>
      <div><span>03</span><div><strong>Détecter</strong><p>Python construit un vivier de signaux statistiques à partir de seuils explicites.</p></div></div>
      <div><span>04</span><div><strong>Sélectionner</strong><p>Gemini compare les signaux et peut décider de ne pas publier un sujet trop faible.</p></div></div>
    </div>
  </section>
</BaseLayout>
