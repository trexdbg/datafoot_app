---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import stats from '../../data/stats.json';
import { SORARE_REFERRAL_URL } from '../../lib/referrals';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { Content } = await render(article);
const { data } = article;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalPath = `${base}/articles/${article.id}/`;
const siteOrigin = Astro.site ?? new URL('https://trexdbg.github.io');
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const methodUrl = new URL(`${base}/methodologie/`, siteOrigin).toString();
const homeUrl = new URL(`${base}/`, siteOrigin).toString();

const norm = (value: string) => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').trim();
const playerStat = stats.top_players.find((p) => norm(p.name) === norm(data.player));
const profiles = (((stats as any).player_profiles ?? (stats as any).sorare_players ?? []) as any[]);
const profile = profiles.find((p) => norm(p.matched_from || p.player) === norm(data.player));
const delta = playerStat?.xg_delta ?? null;

type ArticleVisual = { kind:string; src:string; alt:string; caption:string; source:string };
const visuals = ((((stats as any).article_visuals ?? {})[article.id] ?? []) as ArticleVisual[]);
const visual = visuals[0];
const primarySourceHref = data.source === 'Sorare' ? SORARE_REFERRAL_URL : data.sourceUrl;
const firstVisualUrl = visual?.src ? new URL(`${base}${visual.src}`, siteOrigin).toString() : undefined;

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: data.title, description: data.description, url: canonicalUrl,
  mainEntityOfPage: canonicalUrl, datePublished: data.publishedAt.toISOString(),
  dateModified: data.publishedAt.toISOString(), inLanguage: 'fr-FR', isAccessibleForFree: true,
  author: { '@type': 'Organization', name: 'DataFoot', url: methodUrl },
  publisher: { '@type': 'Organization', name: 'DataFoot', url: homeUrl },
  about: [{ '@type': 'Person', name: data.player }, { '@type': 'SportsTeam', name: data.team }],
  keywords: [data.player, data.team, data.league.replaceAll('_',' '), 'football', 'xG', 'statistiques football'],
  citation: [data.sourceUrl, ...(profile?.source_url ? [profile.source_url] : [])],
  ...(firstVisualUrl ? { image: firstVisualUrl } : {}),
};
const breadcrumbSchema = {
  '@context':'https://schema.org','@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:'Accueil',item:homeUrl},
    {'@type':'ListItem',position:2,name:'Analyses',item:new URL(`${base}/articles/`,siteOrigin).toString()},
    {'@type':'ListItem',position:3,name:data.title,item:canonicalUrl},
  ],
};
---
<BaseLayout
  title={`${data.title} | DataFoot`}
  description={data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedAt={data.publishedAt.toISOString()}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <article class="report shell">
    <nav class="report-crumbs" aria-label="Fil d’Ariane">
      <a href={`${base}/`}>DF</a><span>/</span><a href={`${base}/articles/`}>ANALYSES</a><span>/</span><span>{data.player.toUpperCase()}</span>
    </nav>

    <header class="report-head">
      <div class="report-stamp">
        <span>DATAFOOT / PLAYER ANALYSIS</span>
        <span>{data.publishedAt.toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',year:'numeric'})}</span>
      </div>
      <div class="report-title-grid">
        <div>
          <p class="signal-tag">{data.league.replaceAll('_',' ')} · {data.team}</p>
          <h1>{data.title}</h1>
          <p class="report-dek">{data.description}</p>
        </div>
      </div>
    </header>

    <section class="snapshot-strip">
      <div><small>JOUEUR</small><strong>{data.player}</strong><span>{data.team}</span></div>
      {playerStat && <div><small>BUTS / xG</small><strong>{playerStat.goals} / {playerStat.xg.toFixed(2)}</strong><span class:list={['snapshot-delta', (delta ?? 0) >= 0 ? 'up' : 'down']}>{delta != null ? `${delta >= 0 ? '+' : ''}${delta.toFixed(2)} Δ` : '—'}</span></div>}
      {playerStat && <div><small>xG / 90</small><strong>{playerStat.xg_per90.toFixed(2)}</strong><span>{playerStat.minutes} minutes</span></div>}
      {playerStat && <div><small>TIRS / 90</small><strong>{playerStat.shots_per90.toFixed(2)}</strong><span>{playerStat.shots} tirs</span></div>}
    </section>

    {visual && (
      <section class="visual-analysis visual-analysis-wide" aria-labelledby="visual-analysis-title">
        <div class="visual-analysis-head">
          <div>
            <p class="signal-tag">PLAYER PROFILE</p>
            <h2 id="visual-analysis-title">Profil statistique.</h2>
          </div>
        </div>
        <figure class="data-figure">
          <img
            src={`${base}${visual.src}`}
            alt={visual.alt}
            width="1200"
            height="620"
            loading="eager"
            decoding="async"
          />
          <figcaption>
            <span>{visual.caption}</span>
            <small>Sources · {visual.source}</small>
          </figcaption>
        </figure>
      </section>
    )}

    <div class="report-grid">
      <main class="report-body">
        <section class="executive-note">
          <div class="note-index">01</div>
          <div>
            <p class="signal-tag">LE SIGNAL</p>
            <p>{data.description}</p>
          </div>
        </section>

        <div class="prose report-prose"><Content /></div>
      </main>

      <aside class="report-aside">
        {playerStat && (
          <section class="side-module">
            <div class="side-module-head"><span>CHIFFRES CLÉS</span><span>SAISON</span></div>
            <dl class="data-list">
              <div><dt>Matchs</dt><dd>{playerStat.games}</dd></div>
              <div><dt>Minutes</dt><dd>{playerStat.minutes}</dd></div>
              <div><dt>Buts</dt><dd>{playerStat.goals}</dd></div>
              <div><dt>Passes déc.</dt><dd>{playerStat.assists}</dd></div>
              <div><dt>xG</dt><dd>{playerStat.xg.toFixed(2)}</dd></div>
              <div><dt>xA</dt><dd>{playerStat.xa.toFixed(2)}</dd></div>
            </dl>
          </section>
        )}

        <section class="side-module source-module">
          <div class="side-module-head"><span>SOURCES</span><span>VÉRIFIÉES</span></div>
          <p>Les statistiques affichées proviennent des sources indiquées et sont normalisées avant publication.</p>
          <a href={primarySourceHref} rel={data.source === 'Sorare' ? 'sponsored nofollow noreferrer' : 'nofollow noreferrer'}>SOURCE PRINCIPALE ↗</a>
          <a href={`${base}/methodologie/`}>MÉTHODE ↗</a>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
