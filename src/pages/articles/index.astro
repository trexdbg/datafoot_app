---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const articles = (await getCollection('articles')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path:string)=>`${base}${path}`;
---
<BaseLayout
  title="Analyses football xG, forme et signaux | DataFoot"
  description="Le desk DataFoot : analyses de joueurs basées sur xG, xA, tirs, forme Sorare et signaux statistiques sourcés."
>
  <section class="shell archive-head">
    <div class="edition-line"><span>DATAFOOT / ANALYSIS ARCHIVE</span><span>{articles.length} REPORTS</span></div>
    <h1>Analysis<br/><span>Archive.</span></h1>
    <p>Les rapports publiés par le desk, triés du plus récent au plus ancien. Chaque ligne conserve la source, le signal et le joueur analysé.</p>
  </section>
  <section class="shell archive-list">
    {articles.map((article,index)=>(
      <a class="archive-row" href={url(`/articles/${article.id}/`)}>
        <span class="archive-no">{String(index+1).padStart(2,'0')}</span>
        <div class="archive-meta"><span>{article.data.league.replaceAll('_',' ')}</span><small>{article.data.publishedAt.toLocaleDateString('fr-FR')}</small></div>
        <div class="archive-title"><h2>{article.data.title}</h2><p>{article.data.player} · {article.data.team}</p></div>
        <span class="archive-source">{article.data.source}</span>
        <div class="archive-score"><small>SIGNAL</small><b>{Math.round(article.data.storyScore)}</b></div>
        <span class="archive-arrow">↗</span>
      </a>
    ))}
  </section>
</BaseLayout>
