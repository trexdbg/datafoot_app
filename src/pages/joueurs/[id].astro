---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivityMiniChart from '../../components/ActivityMiniChart.astro';
import {games,playerList,playedGames,commonScale,getProfile,mbappeId,matchHref,playerHref,formattedDate,matchTitle,opposingTeam,playerGoals} from '../../lib/explorer-data.mjs';
import '../../styles/match-explorer.css';
export function getStaticPaths(){
 return playerList.map(player=>({params:{id:player.id===mbappeId?'mbappe':String(player.id)},props:{playerId:player.id}}));
}
interface Props {playerId:number}
const {playerId}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const player=playerList.find(p=>p.id===playerId)!;
const selected=[...playedGames(playerId)].reverse();
const goals=selected.reduce((sum,game)=>sum+playerGoals(game,playerId).length,0);
const main=playerId===mbappeId;
---
<BaseLayout title={player.name+' · matchs et courbes de la Coupe du monde 2022 | DataFoot'} description={'Retrouver les profils événementiels de '+player.name+' pour chaque rencontre avec la France au Mondial 2022.'} canonicalPath={base+'/joueurs/'+(main?'mbappe':playerId)+'/'}>
 <div class="ax-root"><div class="shell ax-wrap">
  <nav class="ax-breadcrumb" aria-label="Fil d'Ariane"><a href={base+'/'}>DATAFOOT</a><span>/</span><a href={base+'/equipes/france/'}>FRANCE</a><span>/</span>JOUEURS</nav>
  <div class="ax-header"><div>
   <p class="ax-eyebrow">PROFILS DE JOUEURS · MONDIAL 2022</p>
   <h1>{player.name.split(' ').slice(0,-1).join(' ')}<br/><em>{player.name.split(' ').at(-1)}</em></h1>
   <p>{selected.length} rencontre{selected.length>1?'s':''} disponible{selected.length>1?'s':''} avec la France dans cette compétition. Un graphique compact par match pour comparer les évolutions du joueur avec la moyenne de l’équipe.</p>
  </div><div class="ax-header-stat"><strong>{String(selected.length).padStart(2,'0')}</strong><span>MATCHS ANALYSÉS</span><small>{goals} but{goals>1?'s':''} · compétition</small></div></div>
  <div class="ax-subnav"><a href={base+'/equipes/france/'}>France · tous les matchs</a><a class={main?'active':''} href={playerHref(base,mbappeId)}>Mbappé · tous les matchs</a><a href={matchHref(base,games.at(-1))}>Finale · tous les joueurs</a></div>
  <div class="ax-context"><span class="ax-dot pink"></span> Rose : {player.name} <span class="ax-dot blue"></span> Bleu : moyenne de la France <span class="ax-dot goal"></span> Points : buts du joueur</div>
  <div class="ax-search-row"><label for="ax-filter">Rechercher un match</label><input type="search" id="ax-filter" autocomplete="off" placeholder="Adversaire ou date…"/><span id="ax-filter-count">{selected.length} matchs</span></div>
  <div class="ax-card-grid" id="ax-cards">
  {selected.map(game=>{
   const profile=getProfile(game,playerId)!;
   const made=profile.actions.filter((a: {kind:string;outcome:string})=>a.kind==='Pass'&&a.outcome==='Complete').length;
   const won=profile.actions.filter((a: {kind:string;outcome:string})=>a.kind==='Dribble'&&a.outcome==='Complete').length;
   return <article class="ax-match-card" id={'match-'+game.id} data-search={(opposingTeam(game)+' '+game.date+' '+matchTitle(game)).toLocaleLowerCase('fr')}>
    <div class="ax-card-kicker">{formattedDate(game.date)} · {profile.player.entry===0?'TITULAIRE':'ENTRÉE '+profile.player.entry+'′'}</div>
    <a href={matchHref(base,game)} class="ax-match-title">{matchTitle(game)} <span>↗</span></a>
    <p class="ax-card-meta">{profile.actions.length} actions · {made} passes réussies · {won} dribbles réussis</p>
    <ActivityMiniChart duration={game.duration} maxScale={commonScale} series={[{label:player.name,timeline:profile.timeline,color:'#fc8ab9'},{label:'France',timeline:game.team,color:'#59caff'}]} goals={playerGoals(game,playerId)} caption={'Activité de '+player.name+' face à '+opposingTeam(game)+' comparée à la France'}/>
    <div class="ax-card-footer"><a href={matchHref(base,game)}>Afficher l’analyse du match <span>→</span></a><a href={base+'/equipes/france/'}>Tous les matchs</a></div>
   </article>;
  })}
  </div>
  <p class="ax-no-results" id="ax-empty" hidden>Aucun match correspondant à cette recherche.</p>
  <div class="ax-method"><strong>Comparaison juste.</strong> Toutes les courbes ont la même échelle verticale. L’indice commence à 50 à l’entrée en jeu de chaque joueur, évolue selon les actions réussies et s’arrête à la sortie. Lissage visuel uniquement, sans modification des scores calculés.</div>
  <p class="ax-source">Source : <a href="https://github.com/hudl/open-data" target="_blank" rel="noopener noreferrer">StatsBomb Open Data / Hudl</a>. Seuls les matchs de la France au Mondial 2022 sont affichés, pas l’ensemble de la carrière du joueur.</p>
 </div></div>
 <script is:inline>
 (()=>{const search=document.getElementById('ax-filter'),cards=[...document.querySelectorAll('.ax-match-card')],count=document.getElementById('ax-filter-count'),empty=document.getElementById('ax-empty');if(!search)return;search.addEventListener('input',()=>{const q=search.value.trim().toLocaleLowerCase('fr');let visible=0;for(const card of cards){const match=card.dataset.search?.includes(q);card.hidden=!match;if(match)visible++;}count.textContent=visible+' match'+(visible>1?'s':'');empty.hidden=visible!==0;});})();
 </script>
</BaseLayout>
