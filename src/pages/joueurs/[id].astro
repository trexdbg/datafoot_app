---
import {playerList,mbappeId} from '../../lib/explorer-data.mjs';
export function getStaticPaths(){return playerList.map(player=>({params:{id:player.id===mbappeId?'mbappe':String(player.id)},props:{playerId:player.id}}));}
interface Props {playerId:number}
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const target=base+'/mondial-2022/joueurs/'+Astro.props.playerId+'/';
---
<html lang="fr"><head><meta charset="utf-8"/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={'0;url='+target}/><link rel="canonical" href={target}/><title>Redirection · DataFoot Atlas</title></head><body><p>La page de ce joueur est maintenant dans le nouvel explorateur. <a href={target}>Voir ses matchs et ses profils interactifs →</a></p><script is:inline define:vars={{target}}>window.location.replace(target);</script></body></html>