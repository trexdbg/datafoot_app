---
import CountryFlag from '../../../components/CountryFlag.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorldCupNav from '../../../components/WorldCupNav.astro';
import WorldCupWave from '../../../components/WorldCupWave.astro';
import WorldCupMatchComparison from '../../../components/WorldCupMatchComparison.astro';
import {games,matchUrl,countryUrl,playerUrl,detailUrl,peak,mean,flag,labelCountry,playerName,stageLabel,dateLabel,titleMatch,teamTimeline} from '../../../lib/worldcup-data';
import '../../../styles/worldcup.css';
export function getStaticPaths(){return games.map(game=>({params:{id:String(game.id)},props:{matchId:game.id}}));}
interface Props {matchId:number}
const {matchId}=Astro.props;
const game=games.find(g=>g.id===matchId)!;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const teams=[game.home,game.away];
const allPlayers=[...game.profiles].sort((a,b)=>a.player.team.localeCompare(b.player.team)||a.player.entry-b.player.entry||a.player.name.localeCompare(b.player.name,'fr'));
const actions=game.actions.length;
const firstTeam=teamTimeline(game,game.home);
const secondTeam=teamTimeline(game,game.away);
const ownerOf=new Map(game.players.map(player=>[player.id,player.team]));
const actionsFor=(team:string)=>game.actions.filter(action=>ownerOf.get(action.p)===team);
const homeActions=actionsFor(game.home),awayActions=actionsFor(game.away);
const shots=(actions:typeof game.actions)=>actions.filter(action=>action.k==='Shot');
const onTarget=(actions:typeof game.actions)=>shots(actions).filter(action=>['Goal','Saved','Saved to Post'].includes(action.o)).length;
const xg=(actions:typeof game.actions)=>Number(shots(actions).reduce((total,action)=>total+(action.xg??0),0).toFixed(1));
const successfulPasses=(actions:typeof game.actions)=>actions.filter(action=>action.k==='Pass'&&action.o==='Complete').length;
const duelStats=[
 {label:'Tirs',first:shots(homeActions).length,second:shots(awayActions).length,format:'int' as const},
 {label:'Tirs cadrés',first:onTarget(homeActions),second:onTarget(awayActions),format:'int' as const},
 {label:'xG',first:xg(homeActions),second:xg(awayActions),format:'decimal' as const},
 {label:'Passes réussies',first:successfulPasses(homeActions),second:successfulPasses(awayActions),format:'int' as const}
];
const goalMarkers=game.goals.map(goal=>({
 minute:goal.minute,
 team:labelCountry(goal.team),
 kind:goal.kind,
 label:goal.kind==='own-goal'
  ?((game.players.find(p=>p.id===goal.playerId)?playerName(game.players.find(p=>p.id===goal.playerId)!):undefined)??'But contre son camp')
  :((game.players.find(p=>p.id===goal.playerId)?playerName(game.players.find(p=>p.id===goal.playerId)!):undefined)??'Buteur non renseigné')
}));

---
<BaseLayout title={titleMatch(game)+' · profils des deux équipes | DataFoot Atlas'} description={'Toutes les actions et tous les profils joueurs du match '+titleMatch(game)+' au Mondial 2022.'} canonicalPath={matchUrl(base,game.id)}>
<div class="wc-root"><div class="shell wc-wrap">
 <nav class="wc-crumb"><a href={base+'/mondial-2022/'}>64 MATCHS</a><span>/</span>{stageLabel(game.stage)}<span>/</span>{titleMatch(game)}</nav>
 <div class="wc-match-context"><span>{dateLabel(game.date)} · {stageLabel(game.stage)}{game.group?' · GROUPE '+game.group:''}</span><span>{game.duration}′ de données · {allPlayers.length} joueurs</span></div>
 <WorldCupNav active="matches"/>
 <WorldCupMatchComparison home={labelCountry(game.home)} away={labelCountry(game.away)} homeCountry={game.home} awayCountry={game.away} homeScore={game.homeScore} awayScore={game.awayScore} first={firstTeam} second={secondTeam} duration={game.duration} goals={goalMarkers} stats={duelStats}/>
 <div class="wc-country-shortcuts" aria-label="Accès aux pays">
   <span>Explorer les sélections séparément :</span>
   {teams.map(team=><a href={countryUrl(base,team)}><CountryFlag country={team} /> {labelCountry(team)} · parcours du pays →</a>)}
 </div>
 <section aria-labelledby="wc-squad">
  <div class="wc-section-head"><div><p class="wc-eyebrow">JOUEURS SUR LE TERRAIN</p><h2 id="wc-squad">Tous les profils.</h2><p>Clique sur une fiche pour explorer précisément les actions et les pics. Les remplaçants apparaissent à leur entrée en jeu.</p></div><small>{allPlayers.length} joueurs recensés</small></div>
  <div class="wc-toolbar">
   <label for="wc-find-player">RECHERCHER</label><input id="wc-find-player" type="search" placeholder="Joueur ou équipe…" autocomplete="off"/>
   <label for="wc-filter-team">SÉLECTION</label><select id="wc-filter-team"><option value="">Les deux pays</option>{teams.map(team=><option value={team}>{labelCountry(team)}</option>)}</select>
   <span class="wc-filter-count" id="wc-player-total">{allPlayers.length} joueurs</span>
  </div>
  <div class="wc-card-grid">
  {allPlayers.map(view=>{
   const player=view.player,top=peak(view.timeline);
   const ownGoals=game.goals.filter(g=>g.playerId===player.id&&g.kind==='goal').map(g=>g.minute);
   const assists=view.actions.filter(a=>a.goalAssist).map(a=>a.minute);
   const passes=view.actions.filter(a=>a.kind==='Pass'&&a.outcome==='Complete').length;
   return <article class="wc-card wc-player-card" data-player-name={player.name.toLowerCase()} data-player-team={player.team} data-search={(player.name+' '+playerName(player)+' '+labelCountry(player.team)).toLowerCase()}>
    <div class="wc-card-kicker"><span><CountryFlag country={player.team} /> {labelCountry(player.team)}</span><span>{player.entry===0?'TITULAIRE':'ENTRÉE '+player.entry+'′'}</span></div>
    <h3 class="wc-card-title"><a href={detailUrl(base,game.id,player.id)} style="color:inherit;text-decoration:none">{playerName(player)} ↗</a></h3>
    <div class="wc-card-meta">{view.actions.length} événements · {passes} passes réussies</div>
    <div class="wc-tiny-stats"><span>Pic <strong>{top?.activity?.toFixed(0)??0}</strong> à {top?.minute??0}′</span><span>Moy. <strong>{mean(view.timeline).toFixed(0)}</strong></span></div>
    <WorldCupWave timeline={view.timeline} duration={game.duration} goals={ownGoals} assists={assists} title={'Pulse de '+playerName(player)} compact/>
    <div class="wc-card-arrow"><a href={detailUrl(base,game.id,player.id)} style="color:#aae8ff">Actions et graphique détaillé →</a><a href={playerUrl(base,player.id)} style="color:#9ec5df">Ses matchs ↗</a></div>
   </article>;
  })}
  </div>
  <p class="wc-empty" id="wc-player-empty" hidden>Aucun joueur trouvé dans cette rencontre.</p>
 </section>
 <p class="wc-footnote">Cette page présente la comparaison des équipes et les profils individuels, calculés à partir des événements observés. Les parcours des sélections sont accessibles séparément. Les tirs au but après prolongation ne sont pas inclus dans les événements. Source : <a href={game.source} target="_blank" rel="noopener noreferrer">StatsBomb Open Data / Hudl ↗</a> · <a href={base+'/data/worldcup-2022/matches/'+game.id+'.json'}>Données de ce match (JSON) ↗</a>.</p>
</div></div>
<script is:inline>
(()=>{const find=document.getElementById('wc-find-player'),team=document.getElementById('wc-filter-team');if(!find)return;const cards=[...document.querySelectorAll('.wc-player-card')],count=document.getElementById('wc-player-total'),empty=document.getElementById('wc-player-empty');const normalize=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();function filter(){const q=normalize(find.value.trim()),t=team.value;let n=0;for(const card of cards){const visible=(!q||normalize(card.dataset.search).includes(q))&&(!t||card.dataset.playerTeam===t);card.hidden=!visible;if(visible)n++;}count.textContent=n+' joueur'+(n!==1?'s':'');empty.hidden=n>0;}[find,team].forEach(input=>input.addEventListener('input',filter));})();
</script>
</BaseLayout>