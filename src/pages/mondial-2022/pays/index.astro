---
import CountryFlag from '../../../components/CountryFlag.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorldCupNav from '../../../components/WorldCupNav.astro';
import {countries,countryMatches,countryPlayers,labelCountry,flag,countryUrl} from '../../../lib/worldcup-data';
import '../../../styles/worldcup.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="32 pays du Mondial 2022 | DataFoot Atlas" description="Découvrez le parcours, les matchs et les joueurs des 32 sélections de la Coupe du monde 2022." canonicalPath={base+'/mondial-2022/pays/'}>
<div class="wc-root"><div class="shell wc-wrap">
 <nav class="wc-crumb"><a href={base+'/'}>DATAFOOT</a><span>/</span><a href={base+'/mondial-2022/'}>MONDIAL 2022</a><span>/</span>PAYS</nav>
 <header class="wc-hero"><div><p class="wc-eyebrow">WORLD CUP ATLAS / 32 PAYS</p><h1>Un pays.<br/><em>Un parcours.</em></h1><p>Retrouve toutes les rencontres d’une sélection, la courbe d’activité collective de chaque match et les profils individuels de ses joueurs.</p></div><div class="wc-hero-side"><div><strong>32</strong><span>SÉLECTIONS</span></div><div><strong>8</strong><span>GROUPES</span></div><div><strong>64</strong><span>MATCHS</span></div></div></header>
 <WorldCupNav active="countries"/>
 <div class="wc-section-head"><div><p class="wc-eyebrow">SÉLECTIONNER UN PAYS</p><h2>Toutes les sélections.</h2></div></div>
 <div class="wc-toolbar"><label for="wc-country-find">RECHERCHER</label><input id="wc-country-find" type="search" placeholder="Pays : Argentine, Japon, Maroc…" autocomplete="off"/><span class="wc-filter-count" id="wc-country-count">{countries.length} pays</span></div>
 <div class="wc-country-grid">
  {countries.map(country=><a class="wc-country-tile" href={countryUrl(base,country)} data-country-name={labelCountry(country).toLowerCase()}><span class="wc-country-flag"><CountryFlag country={country} /></span><span><strong>{labelCountry(country)}</strong><small>{countryMatches(country).length} matchs · {countryPlayers(country).length} joueurs recensés</small></span></a>)}
 </div>
 <p class="wc-empty" id="wc-country-empty" hidden>Aucun pays correspondant à la recherche.</p>
 <p class="wc-footnote">Les sélections sont listées sans classement éditorial ni favoritisme. Les événements et compositions proviennent de <a href="https://github.com/hudl/open-data" target="_blank" rel="noopener noreferrer">StatsBomb Open Data ↗</a>.</p>
</div></div>
<script is:inline>
(()=>{const input=document.getElementById('wc-country-find');if(!input)return;const cards=[...document.querySelectorAll('[data-country-name]')],count=document.getElementById('wc-country-count'),empty=document.getElementById('wc-country-empty');input.addEventListener('input',()=>{const q=input.value.trim().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();let found=0;for(const card of cards){const match=card.dataset.countryName.normalize('NFD').replace(/[\u0300-\u036f]/g,'').includes(q);card.hidden=!match;if(match)found++;}count.textContent=found+' pays';empty.hidden=found!==0;});})();
</script>
</BaseLayout>