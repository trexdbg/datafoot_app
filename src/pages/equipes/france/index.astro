---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActivityMiniChart from '../../../components/ActivityMiniChart.astro';
import {games,commonScale,getProfile,mbappeId,matchHref,playerHref,formattedDate,matchTitle,opposingTeam,teamGoals,matchProfileHref} from '../../../lib/explorer-data.mjs';
import '../../../styles/match-explorer.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const sorted=[...games].reverse();
---
<BaseLayout title="France · 7 profils de match, Coupe du monde 2022 | DataFoot" description="Comparer les sept rencontres de la France au Mondial 2022 et accéder au profil de chaque joueur." canonicalPath={base+'/equipes/france/'}>
 <div class="ax-root">
  <div class="shell ax-wrap">
   <nav class="ax-breadcrumb" aria-label="Fil d'Ariane"><a href={base+'/'}>DATAFOOT</a><span>/</span>ÉQUIPE DE FRANCE</nav>
   <div class="ax-header">
    <div><p class="ax-eyebrow">EXPLORATEUR · COUPE DU MONDE 2022</p><h1>La France.<br/><em>Match par match.</em></h1><p>Sept rencontres, un indice commun et des comparaisons immédiates. Choisis un match pour afficher sa courbe collective et les graphiques de tous les joueurs.</p></div>
    <div class="ax-header-stat"><strong>07</strong><span>RENCONTRES AVEC DONNÉES</span><small>StatsBomb · Mondial 2022</small></div>
   </div>
   <div class="ax-subnav"><a class="active" href={base+'/equipes/france/'}>France · matchs</a><a href={playerHref(base,mbappeId)}>Mbappé · matchs</a><a href={matchHref(base,sorted[0])}>Finale · joueurs</a></div>
   <div class="ax-context"><span class="ax-dot blue"></span> Bleu : moyenne des joueurs présents sur le terrain <span class="ax-dot pink"></span> Rose : Mbappé <span class="ax-dot goal"></span> Points : buts français</div>
   <div class="ax-search-row"><label for="ax-filter">Retrouver une rencontre</label><input id="ax-filter" type="search" placeholder="Adversaire, date… ex. Argentine" autocomplete="off"/><span id="ax-filter-count">{sorted.length} matchs</span></div>
   <div class="ax-card-grid" id="ax-cards">
    {sorted.map(game=><article class="ax-match-card" data-search={(game.date+' '+opposingTeam(game)+' '+matchTitle(game)).toLocaleLowerCase('fr')}>
      <div class="ax-card-kicker">{formattedDate(game.date)} · COUPE DU MONDE</div>
      <a class="ax-match-title" href={matchHref(base,game)}>{matchTitle(game)} <span aria-hidden="true">↗</span></a>
      <p class="ax-card-meta">Profil collectif France + Mbappé · {game.duration}′</p>
      <ActivityMiniChart duration={game.duration} maxScale={commonScale} series={[{label:'France',timeline:game.team,color:'#5ac9ff'},{label:'Mbappé',timeline:getProfile(game,mbappeId)?.timeline??[],color:'#fc8ab9'}]} goals={teamGoals(game)} caption={'Comparaison de la France et Mbappé contre '+opposingTeam(game)} />
      <div class="ax-card-footer"><a class="ax-detail-link" href={matchProfileHref(base,game)}>Points et actions France <span>↗</span></a><a href={matchProfileHref(base,game,mbappeId)}>Détail Mbappé ↗</a><a href={matchHref(base,game)}>Tous les joueurs →</a></div>
     </article>)}
   </div>
   <p class="ax-no-results" id="ax-empty" hidden>Aucun match correspondant à cette recherche.</p>
   <div class="ax-method"><strong>Comment lire la courbe ?</strong> Chaque joueur commence à 50 à son entrée, perd 1 par minute, gagne 5 par passe ou dribble réussi et 45 par but. Le score ne descend jamais sous zéro. La moyenne collective est calculée sur les joueurs présents sur le terrain. Les petites courbes sont lissées uniquement pour l'affichage ; les scores restent inchangés.</div>
   <p class="ax-source">Couverture actuelle : les 7 matchs de la France au Mondial 2022 disponibles dans <a href="https://github.com/hudl/open-data" rel="noopener noreferrer" target="_blank">StatsBomb Open Data</a>. La carrière complète des joueurs n'est pas encore couverte.</p>
  </div>
 </div>
 <script is:inline>
 (()=>{const search=document.getElementById('ax-filter'),cards=[...document.querySelectorAll('.ax-match-card')],count=document.getElementById('ax-filter-count'),empty=document.getElementById('ax-empty');if(!search)return;search.addEventListener('input',()=>{const q=search.value.trim().toLocaleLowerCase('fr');let visible=0;for(const card of cards){const match=card.dataset.search?.includes(q);card.hidden=!match;if(match)visible++;}count.textContent=visible+' match'+(visible>1?'s':'');empty.hidden=visible!==0;});})();
 </script>
</BaseLayout>
